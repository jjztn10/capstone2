<%# SMARTWORK HEADER (Admin + User).
    Optional locals: layoutType, user, headerTitle, headerDescription, headerIcon, showRefreshButton %>

<%
/* ------------------------------------------------
   1. Per-layout defaults
------------------------------------------------ */
const hType = (typeof layoutType !== "undefined" && layoutType === "admin") ? "admin" : "user";

const headerDefaults = {
    admin: {
        title: "SmartWork Admin Dashboard",
        description: "Manage your platform and monitor productivity.",
        icon: "fa-user-shield",
        showRefresh: false, // the dashboard page already has its own #refreshDashboardBtn
        fallbackUser: { name: "Administrator", role: "System Administrator" },
        menu: [
            { label: "Settings", icon: "fa-cog", url: "/admindashboard#settingsSection" }
        ]
    },
    user: {
        title: "SmartWork Dashboard",
        description: "Stay organized and make things simple.",
        icon: "fa-user",
        showRefresh: false,
        fallbackUser: { name: "User", role: "Member" },
        menu: [
            { label: "My Profile", icon: "fa-user", url: "/userdashboard/profile" }
        ]
    }
};

const hd = headerDefaults[hType];

/* ------------------------------------------------
   2. Resolve values (page-level locals override defaults)
------------------------------------------------ */
const hUser = (typeof user !== "undefined" && user) ? user : hd.fallbackUser;

const hTitle       = (typeof headerTitle !== "undefined" && headerTitle) ? headerTitle : hd.title;
const hDescription = (typeof headerDescription !== "undefined" && headerDescription) ? headerDescription : hd.description;
const hIcon        = (typeof headerIcon !== "undefined" && headerIcon) ? headerIcon : hd.icon;
const hRefresh     = (typeof showRefreshButton !== "undefined") ? showRefreshButton : hd.showRefresh;
%>

<header class="admin-header <%= hType === 'admin' ? 'admin-header-mode' : 'user-header-mode' %>">

    <!-- LEFT: TITLE -->
    <div class="admin-header-title">
        <div class="admin-header-icon">
            <i class="fas <%= hIcon %>"></i>
        </div>

        <div class="admin-header-content">
            <h1><%= hTitle %></h1>
            <p><%= hDescription %></p>
        </div>
    </div>

    <!-- RIGHT: ACTIONS + PROFILE -->
    <div class="admin-header-right">

        <% if (hRefresh) { %>
            <button type="button" id="refreshDashboardBtn" class="btn btn-refresh">
                <i class="fas fa-sync-alt"></i>
                Refresh Dashboard
            </button>
        <% } %>

        <div class="admin-profile dropdown">

            <a href="#"
               class="admin-profile-toggle dropdown-toggle"
               id="smartWorkProfileDropdown"
               role="button"
               data-toggle="dropdown"
               aria-haspopup="true"
               aria-expanded="false">

                <div class="profile-info">
                    <h6><%= hUser.name || hd.fallbackUser.name %></h6>
                    <small><%= hUser.role || hd.fallbackUser.role %></small>
                </div>

                <div class="profile-avatar">
                    <% if (hUser.avatar) { %>
                        <img src="<%= hUser.avatar %>" alt="Profile">
                    <% } else { %>
                        <i class="fas fa-user"></i>
                    <% } %>
                </div>

            </a>

            <div class="dropdown-menu dropdown-menu-right shadow"
                 aria-labelledby="smartWorkProfileDropdown">

                <% hd.menu.forEach(link => { %>
                    <a class="dropdown-item" href="<%= link.url %>">
                        <i class="fas <%= link.icon %> fa-sm fa-fw mr-2"></i>
                        <%= link.label %>
                    </a>
                <% }) %>

                <div class="dropdown-divider"></div>

                <a class="dropdown-item text-danger" href="/logout">
                    <i class="fas fa-sign-out-alt fa-sm fa-fw mr-2"></i>
                    Logout
                </a>

            </div>
        </div>

    </div>

</header>