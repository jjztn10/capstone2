<!-- TEAM WORKLOAD VS STRESS + ANOMALIES (admin overview) -->
<div class="card shadow mb-4" id="teamInsights">
    <div class="card-header d-flex justify-content-between align-items-center">
        <strong><i class="fas fa-fire" style="color:#2d5a3d"></i> Team workload vs stress</strong>
        <button class="btn btn-sm btn-success" id="btnTeamRefresh" type="button">
            <i class="fas fa-sync-alt"></i> Refresh
        </button>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Open</th>
                        <th>Overdue</th>
                        <th style="min-width:140px">Workload</th>
                        <th>Stress (7d)</th>
                        <th>Last 7 days</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="teamBody">
                    <tr><td colspan="7" class="text-center text-muted py-4">Loading...</td></tr>
                </tbody>
            </table>
        </div>

        <hr>

        <h6 class="font-weight-bold mb-2">Unusual changes (z-score vs each person's own normal)</h6>
        <div id="anomalyList" class="text-muted">Loading...</div>
        <div id="anomalyNotes" class="small text-muted mt-2"></div>
    </div>
</div>

<script>
(() => {
    "use strict";

    const BASE = "/admindashboard";          // your admin route prefix

    const $ = (id) => document.getElementById(id);

    const esc = (v) => String(v ?? "").replace(/[&<>"']/g, c =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

    // 1 (calm) = green ... 10 = red
    const heat = (v) => v == null ? "#e5e7eb" : `hsl(${Math.round(120 - (v - 1) / 9 * 120)},65%,62%)`;

    const STATUS = {
        overloaded: '<span class="badge badge-danger">Overloaded</span>',
        watch:      '<span class="badge badge-warning">Watch</span>',
        ok:         '<span class="badge badge-success">OK</span>'
    };

    async function get(path) {
        const res = await fetch(BASE + path, { credentials: "same-origin", cache: "no-store" });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || "Request failed (" + res.status + ")");
        return data;
    }

    function renderHeatmap(rows) {
        if (!rows.length) {
            $("teamBody").innerHTML = `<tr><td colspan="7" class="text-center text-muted py-4">No users.</td></tr>`;
            return;
        }

        $("teamBody").innerHTML = rows.map(r => `
            <tr>
                <td><strong>${esc(r.name)}</strong></td>
                <td>${r.openTasks}</td>
                <td>${r.overdue}</td>
                <td>
                    <div class="progress" style="height:14px" title="${r.workload}%">
                        <div class="progress-bar ${r.workload >= 70 ? "bg-danger" : r.workload >= 40 ? "bg-warning" : "bg-success"}"
                             style="width:${r.workload}%">${r.workload}%</div>
                    </div>
                </td>
                <td><span class="badge" style="background:${heat(r.stress)};color:#111">${r.stress ?? "-"}</span></td>
                <td style="white-space:nowrap">
                    ${r.days.map(v => `<span title="${v ?? "no entry"}" style="display:inline-block;width:18px;height:18px;margin-right:2px;border-radius:4px;background:${heat(v)}"></span>`).join("")}
                </td>
                <td>${STATUS[r.status] || ""}</td>
            </tr>`).join("");
    }

    function renderAnomalies(d) {
        const list = d.anomalies || [];

        $("anomalyList").innerHTML = list.length
            ? list.map(a => `
                <div class="mb-2">
                    <span class="badge ${a.type === "stress"
                        ? (a.direction === "up" ? "badge-danger" : "badge-info")
                        : (a.direction === "down" ? "badge-warning" : "badge-success")}">
                        ${a.type === "stress" ? "Stress" : "Productivity"} ${a.direction === "up" ? "↑" : "↓"}
                    </span>
                    <strong>${esc(a.name)}</strong>: ${esc(a.message)}
                    <span class="text-muted small">(z = ${esc(a.z)})</span>
                </div>`).join("")
            : "No unusual changes detected. Everyone is close to their own normal.";

        $("anomalyNotes").textContent = (d.notes || []).join(" ");
    }

    async function loadTeam() {
        try {
            const [h, a] = await Promise.all([get("/api/team/heatmap"), get("/api/team/anomalies")]);
            renderHeatmap(h.rows || []);
            renderAnomalies(a);
        } catch (e) {
            console.error(e);
            $("teamBody").innerHTML = `<tr><td colspan="7" class="text-center text-danger py-4">${esc(e.message)}</td></tr>`;
            $("anomalyList").textContent = "";
        }
    }

    $("btnTeamRefresh")?.addEventListener("click", loadTeam);

    // reload when the admin dashboard's own refresh button is used
    $("btnRefreshDashboard")?.addEventListener("click", loadTeam);

    loadTeam();
})();
</script>