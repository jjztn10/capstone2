<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= typeof title !== "undefined" ? title : "SmartWork" %></title>

    <!-- Apply saved theme before paint (prevents a light flash in dark mode) -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem("theme");
                if (t) document.documentElement.setAttribute("data-theme", t);
            } catch (e) {}
        })();
    </script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <% if (typeof pageStyle !== "undefined" && pageStyle) { %>
        <link rel="stylesheet" href="/stylesheets/<%= pageStyle %>" />
    <% } %>

    <style>
        /* Background image layer, sits at the lowest z-index */
        .bg-layer {
            position: fixed;
            inset: 0;
            z-index: -1;
            background-image: url('/images/login1.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            pointer-events: none;
        }

        /* Tint so the login card stays readable on any photo */
        .bg-layer::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(15, 20, 36, 0.35);
        }

        body#page-top,
        #wrapper,
        #content-wrapper,
        #content {
            background: transparent !important;
        }
    </style>
</head>

<body id="page-top">

    <div class="bg-layer"></div>

    <div id="wrapper">
        <div id="content-wrapper" class="d-flex flex-column">
            <div id="content">
                <%- include(body) %>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.2/js/bootstrap.bundle.min.js"></script>

    <!-- Theme toggle -->
    <script>
        (function () {
            var root = document.documentElement;
            var btn = document.getElementById("themeBtn");
            if (!btn) return;

            function syncIcon() {
                btn.innerHTML = root.getAttribute("data-theme") === "dark"
                    ? '<i class="fas fa-sun"></i>'
                    : '<i class="fas fa-moon"></i>';
            }
            syncIcon();

            btn.addEventListener("click", function () {
                var next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
                root.setAttribute("data-theme", next);
                try { localStorage.setItem("theme", next); } catch (e) {}
                syncIcon();
            });
        })();
    </script>

    <!-- Page-specific script -->
    <% if (typeof pageScript !== "undefined" && pageScript) { %>
        <%- include(pageScript) %>
    <% } %>

</body>

</html>