
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= title || "SmartWork" %></title>

    <!-- Favicon -->
    <link rel="icon" href="data:,">

    <!-- Google Font: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet"
    >

    <!-- Bootstrap 4.6.2 CSS -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    >

    <!-- Font Awesome -->
    <link rel="stylesheet" href="/vendor/fontawesome-free/css/all.min.css">

    <!-- SB Admin 2 -->
    <link rel="stylesheet" href="/stylesheets/sb-admin-2.min.css">
    <link rel="stylesheet" href="/stylesheets/sidebar.css">
    <!-- Global CSS -->
    <link rel="stylesheet" href="/stylesheets/style.css">


    <!-- ======================================
         ADMIN CSS
    ======================================= -->

    <% if (typeof layoutType !== "undefined" && layoutType === "admin") { %>

        <link rel="stylesheet" href="/stylesheets/admin/admin-layout.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-header.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-navigation.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-cards.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-tables.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-forms.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-modals.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-charts.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-components.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-responsive.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-theme.css">
        

    <% } else if (typeof pageStyle !== "undefined" && pageStyle) { %>

        <link rel="stylesheet" href="/stylesheets/<%= pageStyle %>">

    <% } %>

</head>


<body
    id="page-top"
    class="<%= (typeof layoutType !== 'undefined' && layoutType === 'admin') ? 'admin-body' : 'main-body' %>"
>

    <!-- Page Wrapper -->
    <div id="wrapper">

        <!-- Sidebar -->
        <%- include("../components/sidebar") %>


        <!-- Content Wrapper -->
        <div id="content-wrapper" class="d-flex flex-column">

            <!-- Main Content -->
            <div id="content">

                <!-- Page Content -->
                <main class="container-fluid py-4">

                    <%- body %>

                </main>

            </div>


            <!-- Footer -->
            <%- include("../components/footer") %>

        </div>

    </div>


    <!-- Scroll to Top -->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>


    <!-- ======================================
         CORE JAVASCRIPT
    ======================================= -->

    <!-- jQuery -->
    <script src="/vendor/jquery/jquery.min.js"></script>

    <!-- Bootstrap 4.6.2 -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- jQuery Easing -->
    <script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

    <!-- SB Admin 2 -->
    <script src="/javascripts/sb-admin-2.min.js"></script>


    <!-- ======================================
         DASHBOARD CHART LIBRARY
    ======================================= -->

    <% if (typeof pageScript !== "undefined" && pageScript === "admindashboard-script") { %>

        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <% } %>


    <!-- ======================================
         PAGE-SPECIFIC EJS SCRIPT
    ======================================= -->

    <% if (typeof pageScript !== "undefined" && pageScript) { %>

        <%- include("../scripts/" + pageScript) %>

    <% } %>


</body>
</html>
