<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= typeof title !== "undefined" && title ? title : "SmartWork" %></title>

    <!-- Favicon -->
    <link rel="icon" href="data:,">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Font Awesome 5 (CDN) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <!-- SB Admin 2 (includes Bootstrap 4 styles) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/css/sb-admin-2.min.css">

    <%
        const lt  = (typeof layoutType  !== "undefined") ? layoutType  : "";
        const ps  = (typeof pageScript  !== "undefined") ? pageScript  : "";
        const cp  = (typeof currentPath !== "undefined") ? currentPath : "";

        // Page CSS: admin pages keep their files in /stylesheets/admin/,
        // so "admin-dashboard.css" becomes "admin/admin-dashboard.css".
        let pst = (typeof pageStyle !== "undefined" && pageStyle) ? String(pageStyle) : "";
        if (pst && lt === "admin" && pst.indexOf("/") === -1) {
            pst = "admin/" + pst;
        }

        // Files already linked above, so they are never linked twice
        const alreadyLoaded = [
            "user/dashboard.css",
            "admin/admin-layout.css",
            "admin/admin-navigation.css",
            "admin/admin-cards.css",
            "admin/admin-tables.css",
            "admin/admin-forms.css",
            "admin/admin-modals.css",
            "admin/admin-charts.css",
            "admin/admin-components.css",
            "admin/admin-responsive.css",
            "admin/admin-theme.css",
            "admin/admin-pages.css"
        ];
    %>

    <!-- ==========================================
         SHARED CSS (admin + user)
    =========================================== -->
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/sidebar.css">
    <link rel="stylesheet" href="/stylesheets/admin/admin-header.css">

    <!-- ==========================================
         ADMIN CSS  (public/stylesheets/admin/)
    =========================================== -->
    <% if (lt === "admin") { %>
        <link rel="stylesheet" href="/stylesheets/admin/admin-layout.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-navigation.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-cards.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-tables.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-forms.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-modals.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-charts.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-components.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-responsive.css">
        <link rel="stylesheet" href="/stylesheets/admin/admin-theme.css">

        <!-- Shared look for Users / Tasks / Mood / Sessions / Leaderboard pages -->
        <link rel="stylesheet" href="/stylesheets/admin/admin-pages.css">
    <% } %>

    <!-- ==========================================
         USER CSS  (public/stylesheets/user/)
    =========================================== -->
    <% if (lt === "user") { %>
        <link rel="stylesheet" href="/stylesheets/user/dashboard.css">

        <!-- keep the scroll-to-top arrow clear of the assistant button -->
        <style>
            a.scroll-to-top { bottom: 90px; }
        </style>
    <% } %>

    <!-- Optional page CSS (skips any file already loaded above) -->
    <% if (pst && alreadyLoaded.indexOf(pst) === -1) { %>
        <link rel="stylesheet" href="/stylesheets/<%= pst %>">
    <% } %>

    <!-- Responsive styles (phones, tablets, laptops, monitors) - keep LAST -->
    <link rel="stylesheet" href="/stylesheets/responsive.css">

</head>

<body id="page-top" class="<%= lt === 'admin' ? 'admin-body' : 'main-body' %>">

    <div id="wrapper">

        <!-- Sidebar (single merged component for admin + user) -->
        <% if (lt === "admin" || lt === "user") { %>
            <%- include("../components/sidebar", { layoutType: lt, currentPath: cp }) %>
            <button type="button" class="sidebar-backdrop" id="sidebarBackdrop" aria-label="Close navigation" hidden></button>
        <% } %>

        <div id="content-wrapper" class="d-flex flex-column">

            <div id="content">
                <main class="container-fluid py-4">

                    <!-- Header (single merged component for admin + user) -->
                    <% if (lt === "admin" || lt === "user") { %>
                        <%- include("../components/header") %>
                    <% } %>

                    <%- body %>
                </main>
            </div>

            <!-- Footer -->
            <footer class="sticky-footer bg-white">
                <div class="container my-auto">
                    <div class="copyright text-center my-auto">
                        <span>Copyright &copy; SmartWork <%= new Date().getFullYear() %></span>
                    </div>
                </div>
            </footer>

        </div>

    </div>

    <!-- Scroll To Top -->
    <a class="scroll-to-top rounded" href="#page-top">
        <i class="fas fa-angle-up"></i>
    </a>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- SB Admin 2 (sidebar toggle etc.) -->
    <script src="https://cdn.jsdelivr.net/npm/startbootstrap-sb-admin-2@4.1.4/js/sb-admin-2.min.js"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Chart.js: user dashboard, analytics, mood
         (admin dashboard page loads its own copy, so it is not loaded twice) -->
    <% if (/(^|\/)(dashboard|analytics|mood)-script$/.test(ps)) { %>
        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <% } %>

    <%- include("../scripts/main-script.ejs") %>

    <!-- Page Script -->
    <% if (ps) { %>
        <% try { %>
            <%- include("../scripts/" + ps) %>
        <% } catch (e) { console.error("Page script not found:", ps, e.message); } %>
    <% } %>

    <!-- User-only scripts -->
    <% if (lt === "user") { %>

        <!-- Daily mood check-in (once a day, cannot be dismissed, resets at midnight) -->
        <% try { %>
            <%- include("../scripts/moodgate-script") %>
        <% } catch (e) { console.error("moodgate-script not found:", e.message); } %>

        <!-- Chat assistant: "What should I work on today?" -->
        <% try { %>
            <%- include("../scripts/assistant-script") %>
        <% } catch (e) { console.error("assistant-script not found:", e.message); } %>

    <% } %>

</body>

</html>