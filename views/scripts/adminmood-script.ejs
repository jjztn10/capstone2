<script>
(() => {
    "use strict";

    const API = "/admindashboard/api/mood";

    const $ = (id) => document.getElementById(id);

    const COLORS = {
        happy: "#2d5a3d",
        neutral: "#4e73df",
        stressed: "#f6c23e",
    };

    const PALETTE = [
        "#2d5a3d",
        "#9bc27a",
        "#4e73df",
        "#f6c23e",
        "#e74a3b",
        "#858796",
        "#17a2b8",
    ];

    const esc = (v) =>
        String(v ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
        })[c]);

    function parseDay(s) {
        const m = String(s || "").match(/^(\d{4})-(\d{2})-(\d{2})/);
        return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
    }

    function fmtDay(s) {
        const d = parseDay(s);
        return d ? d.toLocaleDateString() : esc(s || "-");
    }

    function fmtShort(s) {
        const d = parseDay(s);
        return d
            ? d.toLocaleDateString(undefined, {
                  month: "short",
                  day: "numeric",
              })
            : s;
    }

    async function request(path = "") {
        const res = await fetch(API + path, {
            cache: "no-store",
            headers: {
                "Content-Type": "application/json",
            },
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
            throw new Error(data.error || "Request failed");
        }

        return data;
    }

    function drawChart(canvasId, emptyId, hasData, config) {
        const canvas = $(canvasId);
        const empty = $(emptyId);

        if (!canvas || typeof Chart === "undefined") return;

        const oldChart = Chart.getChart(canvas);

        if (oldChart) oldChart.destroy();

        canvas.classList.toggle("d-none", !hasData);

        if (empty) {
            empty.classList.toggle("d-none", hasData);
        }

        if (hasData) {
            new Chart(canvas, config);
        }
    }

    function badge(log) {
        let cls = "primary";

        if (log.category === "happy") cls = "success";
        else if (log.category === "stressed") cls = "warning";

        return `<span class="badge badge-${cls}">${esc(log.mood)}</span>`;
    }

    function renderInsights(d) {

        const {
            currentStress,
            previousStress,
            repeatedStress
        } = d.insights;

        const box = $("moodInsights");

        let html = "";

        if (currentStress == null) {

            html += `
                <div class="alert alert-info">
                    <strong>Not enough data</strong>
                    <p class="mb-0">
                        No mood entries were logged in the last ${d.days} days.
                    </p>
                </div>`;

        } else if (previousStress == null) {

            html += `
                <div class="alert alert-info">
                    <strong>Average stress: ${currentStress.toFixed(1)}</strong>
                    <p class="mb-0">
                        There is no earlier period yet to compare with.
                    </p>
                </div>`;

        } else {

            const diff = currentStress - previousStress;

            if (diff <= -0.3) {

                html += `
                    <div class="alert alert-success">
                        <strong>Positive Trend</strong>
                        <p class="mb-0">
                            Average stress fell from ${previousStress.toFixed(1)}
                            to ${currentStress.toFixed(1)}.
                        </p>
                    </div>`;

            } else if (diff >= 0.3) {

                html += `
                    <div class="alert alert-danger">
                        <strong>Rising Stress</strong>
                        <p class="mb-0">
                            Average stress rose from ${previousStress.toFixed(1)}
                            to ${currentStress.toFixed(1)}.
                        </p>
                    </div>`;

            } else {

                html += `
                    <div class="alert alert-info">
                        <strong>Stable</strong>
                        <p class="mb-0">
                            Stress level remains stable.
                        </p>
                    </div>`;
            }
        }

        if (repeatedStress.length) {

            html += `
                <div class="alert alert-warning">
                    <strong>Attention Needed</strong>
                    <ul class="mb-0 pl-3">
                        ${repeatedStress
                            .map(x => `<li>${esc(x.name)} (${x.count})</li>`)
                            .join("")}
                    </ul>
                </div>`;

        } else {

            html += `
                <div class="alert alert-success">
                    <strong>No repeated stress detected.</strong>
                </div>`;
        }

        html += `
            <div class="alert alert-info mb-0">
                <strong>Recommendation</strong>
                <p class="mb-0">
                    ${
                        d.stats.burnout > 0
                            ? `${d.stats.burnout} student(s) are at burnout risk. Schedule wellness check-ins.`
                            : "Continue monitoring students regularly."
                    }
                </p>
            </div>`;

        box.innerHTML = html;
    }

    function render(d) {

        $("moodHappy").textContent = d.stats.happy;
        $("moodNeutral").textContent = d.stats.neutral;
        $("moodStressed").textContent = d.stats.stressed;
        $("moodBurnout").textContent = d.stats.burnout;

        drawChart("moodTrendChart","moodTrendEmpty",d.trend.labels.length,{
            type:"line",
            data:{
                labels:d.trend.labels.map(fmtShort),
                datasets:[
                    {
                        label:"Avg Stress",
                        data:d.trend.stress,
                        borderColor:"#e74a3b",
                        fill:true,
                        tension:.35
                    },
                    {
                        label:"Avg Workload",
                        data:d.trend.workload,
                        borderColor:COLORS.happy,
                        fill:true,
                        tension:.35
                    }
                ]
            },
            options:{
                responsive:true,
                maintainAspectRatio:false
            }
        });

        drawChart("moodPieChart","moodPieEmpty",d.distribution.values.length,{
            type:"doughnut",
            data:{
                labels:d.distribution.labels,
                datasets:[{
                    data:d.distribution.values,
                    backgroundColor:d.distribution.labels.map((_,i)=>PALETTE[i%PALETTE.length])
                }]
            },
            options:{
                responsive:true,
                maintainAspectRatio:false,
                plugins:{
                    legend:{position:"bottom"}
                }
            }
        });

        $("moodTableBody").innerHTML =
            d.logs.length
                ? d.logs.map(l=>`
<tr>
<td>${fmtDay(l.local_day)}</td>
<td>
<div class="font-weight-bold">${esc(l.user_name||"Unknown")}</div>
<small class="text-muted">${esc(l.user_email||"")}</small>
</td>
<td>${badge(l)}</td>
<td>${esc(l.stress_level)}</td>
<td>${esc(l.workload)}</td>
<td>${esc(l.notes||"-")}</td>
</tr>`).join("")
                : `<tr>
<td colspan="6" class="text-center py-4 text-muted">
No mood records found.
</td>
</tr>`;

        renderInsights(d);
    }

    function showError(err){

        console.error(err);

        if(window.Swal){

            Swal.fire({
                icon:"error",
                title:"Unable to load mood data",
                text:err.message,
                confirmButtonColor:"#2d5a3d"
            });

        }else{

            alert(err.message);

        }

    }

   async function load(showSuccess = false) {

    const btn = $("btnRefreshMood");

    if (btn) {
        btn.disabled = true;
        btn.innerHTML =
            '<i class="fas fa-spinner fa-spin"></i> Refreshing...';
    }

    if (showSuccess && window.Swal) {
    Swal.fire({
        title: "Refreshing Mood Analytics",
        text: "Loading latest mood data...",
        allowOutsideClick: false,
        allowEscapeKey: false,
        showConfirmButton: false,
        didOpen: () => {
            Swal.showLoading();
        },
    });
}

    try {

        const days = $("moodRange")
            ? $("moodRange").value
            : 30;

        const data = await request(
            "?days=" + encodeURIComponent(days)
        );

        render(data);

       if (showSuccess && window.Swal) {

    Swal.close();

    Swal.fire({
        icon: "success",
        title: "Mood Analytics Updated",
        text: "Latest mood data has been loaded.",
        timer: 1500,
        showConfirmButton: false,
    });

        }

    } catch (err) {

        console.error(err);

        if (window.Swal) {
            Swal.fire({
                icon: "error",
                title: "Unable to load mood data",
                text: err.message,
                confirmButtonColor: COLORS.happy,
            });
        } else {
            alert(err.message);
        }

    } finally {

        if (btn) {
            btn.disabled = false;
            btn.innerHTML =
                '<i class="fas fa-sync-alt"></i> Refresh';
        }

    }

}

    document.addEventListener("change",(e)=>{

        if(e.target.id==="moodRange"){

            load();

        }

    });

    document.addEventListener("click", (e) => {

    const btn = e.target.closest("#btnRefreshMood");

    if (btn) {

        e.preventDefault();

        load(true);

    }

});

    window.AdminMood={load};

    document.addEventListener("DOMContentLoaded", () => {
    load(false);
});

})();
</script>