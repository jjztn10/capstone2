<script>

window.UserTasks = (() => {

    "use strict";

    const API = "api/tasks";
    const GREEN = "#2d5a3d";

    const $ = (id) => document.getElementById(id);

    /* ======================================================
       STATE
    ====================================================== */

    let tasks = [];
    let filtered = [];
    let saving = false;
    let initialized = false;

    /* ======================================================
       HELPERS
    ====================================================== */

    const esc = (v) =>
        String(v ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
        })[c]);

    const pad = (n) => String(n).padStart(2, "0");

    // Table cell: date on the first line, time on the second.
    // Older tasks were saved without a time (midnight), so they show the date only.
    function formatDeadline(v) {
        if (!v) return "-";

        const d = new Date(v);

        if (isNaN(d)) return "-";

        const date = d.toLocaleDateString(undefined, {
            year: "numeric",
            month: "short",
            day: "numeric"
        });

        if (d.getHours() === 0 && d.getMinutes() === 0) {
            return date;
        }

        const time = d.toLocaleTimeString(undefined, {
            hour: "numeric",
            minute: "2-digit"
        });

        return date + '<br><small class="text-muted">' + time + "</small>";
    }

    // Saved deadline -> value for <input type="datetime-local">
    function toInputValue(v) {
        if (!v) return "";

        const d = new Date(v);

        if (isNaN(d)) return "";

        return d.getFullYear() + "-" +
               pad(d.getMonth() + 1) + "-" +
               pad(d.getDate()) +
               "T" +
               pad(d.getHours()) + ":" +
               pad(d.getMinutes());
    }

    // <input type="datetime-local"> value -> server format
    function toServerDateTime(v) {
        return v ? String(v).replace("T", " ") + ":00" : "";
    }

    function notify(icon, title, text = "") {
        if (window.Swal) {
            return Swal.fire({
                icon,
                title,
                text,
                confirmButtonColor: GREEN,
                timer: icon === "success" ? 1800 : undefined,
                timerProgressBar: icon === "success",
            });
        }

        alert(text ? title + "\n" + text : title);
    }

    async function request(path = "", options = {}) {

        const res = await fetch(API + path, {
            headers: {
                "Content-Type": "application/json"
            },
            ...options,
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
            throw new Error(data.error || "Request failed");
        }

        return data;
    }

    async function confirmAdd(title) {

        if (window.Swal) {

            const result = await Swal.fire({
                icon: "question",
                title: "Add this task?",
                text: 'Are you sure you want to add "' + title + '"?',
                showCancelButton: true,
                confirmButtonColor: GREEN,
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, add it",
                cancelButtonText: "Cancel",
            });

            return result.isConfirmed;
        }

        return confirm("Are you sure you want to add this task?");
    }

    // Generic confirmation popup
    async function confirmAction(options = {}) {

        const {
            icon = "question",
            title = "Are you sure?",
            text = "",
            confirmText = "Yes",
            confirmColor = GREEN
        } = options;

        if (window.Swal) {

            const result = await Swal.fire({
                icon,
                title,
                text,
                showCancelButton: true,
                confirmButtonColor: confirmColor,
                cancelButtonColor: "#6c757d",
                confirmButtonText: confirmText,
                cancelButtonText: "Cancel",
                reverseButtons: true,
                focusCancel: true,
                allowOutsideClick: false
            });

            return result.isConfirmed === true;
        }

        return window.confirm(
            text ? title + "\n" + text : title
        );
    }

    /* ======================================================
       LOAD TASKS
    ====================================================== */

    async function load() {

        try {

            const data = await request();

            tasks = data.tasks || [];

            applyFilters();
            renderSummary();

        } catch (err) {

            console.error(err);

            notify(
                "error",
                "Unable to load tasks",
                err.message
            );
        }
    }

    function changed() {
        document.dispatchEvent(
            new CustomEvent("tasks:changed")
        );
    }

    /* ======================================================
       SUMMARY
    ====================================================== */

    function renderSummary() {

        const count = (s) =>
            tasks.filter(t => t.status === s).length;

        const set = (id, v) => {
            if ($(id)) {
                $(id).textContent = v;
            }
        };

        set("totalTasks", tasks.length);
        set("pendingCount", count("Pending"));
        set("completedCount", count("Completed"));
        set("overdueCount", count("Overdue"));
    }

    /* ======================================================
       STATUS BADGE
    ====================================================== */

    function badge(status) {

        switch (status) {

            case "Completed":
                return "success";

            case "Pending":
                return "warning";

            case "In Progress":
                return "primary";

            case "Overdue":
                return "danger";

            default:
                return "secondary";
        }
    }

    /* ======================================================
       TABLE
       Shows every task, no pagination.
       Actions: Edit + Delete only.
    ====================================================== */

    function renderTable() {

        const tbody = $("taskTableBody");

        if (!tbody) return;

        if (!filtered.length) {

            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        No tasks found.
                    </td>
                </tr>
            `;

            return;
        }

        tbody.innerHTML = filtered.map(task => `

            <tr>

                <td>
                    <strong>${esc(task.title)}</strong>
                </td>

                <td>
                    ${esc(task.subject)}
                </td>

                <td>
                    <span class="badge priority-${esc(task.priority).toLowerCase()}">
                        ${esc(task.priority)}
                    </span>
                </td>

                <td>
                    ${formatDeadline(task.deadline)}
                </td>

                <td>
                    <span class="badge badge-${badge(task.status)}">
                        ${esc(task.status)}
                    </span>
                </td>

                <td class="text-nowrap text-right">

                    <!-- EDIT -->
                    <button
                        type="button"
                        class="btn btn-sm btn-primary btn-edit"
                        title="Edit"
                        aria-label="Edit task"
                        data-id="${esc(task.task_id)}"
                    >
                        <i class="fas fa-edit"></i>
                    </button>

                    <!-- DELETE -->
                    <button
                        type="button"
                        class="btn btn-sm btn-danger btn-delete"
                        title="Delete"
                        aria-label="Delete task"
                        data-id="${esc(task.task_id)}"
                    >
                        <i class="fas fa-trash"></i>
                    </button>

                </td>

            </tr>

        `).join("");
    }

    /* ======================================================
       FILTER
    ====================================================== */

    function applyFilters() {

        const keyword =
            ($("searchTask")?.value || "")
            .trim()
            .toLowerCase();

        const status =
            $("filterStatus")?.value;

        const priority =
            $("filterPriority")?.value;

        filtered = tasks.filter(task => {

            const matchKeyword =
                !keyword ||
                String(task.title ?? "")
                    .toLowerCase()
                    .includes(keyword) ||
                String(task.subject ?? "")
                    .toLowerCase()
                    .includes(keyword);

            const matchStatus =
                !status ||
                task.status === status;

            const matchPriority =
                !priority ||
                task.priority === priority;

            return (
                matchKeyword &&
                matchStatus &&
                matchPriority
            );
        });

        renderTable();
    }

    /* ======================================================
       MODAL
    ====================================================== */

    function clearForm() {

        $("taskId").value = "";
        $("taskTitle").value = "";
        $("taskSubject").value = "";
        $("taskDescription").value = "";
        $("taskPriority").value = "Medium";
        $("taskStatus").value = "Pending";
        $("taskDeadline").value = "";
    }

    function modalAction(action) {

        const el = $("taskModal");

        if (!el) return;

        if (
            window.jQuery &&
            window.jQuery.fn &&
            window.jQuery.fn.modal
        ) {

            window.jQuery(el).modal(action);

        } else if (window.bootstrap) {

            const inst =
                bootstrap.Modal.getOrCreateInstance(el);

            action === "show"
                ? inst.show()
                : inst.hide();
        }
    }

    const openModal = (title = "Add Task") => {

        $("taskModalTitle").textContent = title;

        modalAction("show");
    };

    const closeModal = () =>
        modalAction("hide");

    /* ======================================================
       SAVE
       Asks for confirmation only when adding.
    ====================================================== */

    async function saveTask() {

        if (saving) return;

        const payload = {

            title:
                $("taskTitle").value.trim(),

            subject:
                $("taskSubject").value.trim(),

            description:
                $("taskDescription").value.trim(),

            priority:
                $("taskPriority").value,

            status:
                $("taskStatus").value,

            deadline:
                toServerDateTime(
                    $("taskDeadline").value
                ),
        };

        if (!payload.title) {

            notify(
                "warning",
                "Task title is required"
            );

            return;
        }

        const id = $("taskId").value;

        // Ask only when adding a new task
        if (
            !id &&
            !(await confirmAdd(payload.title))
        ) {
            return;
        }

        saving = true;

        const btn = $("btnSaveTask");

        if (btn) {
            btn.disabled = true;
        }

        try {

            if (id) {

                await request("/" + id, {
                    method: "PUT",
                    body: JSON.stringify(payload)
                });

            } else {

                await request("", {
                    method: "POST",
                    body: JSON.stringify(payload)
                });
            }

            closeModal();

            notify(
                "success",
                id ? "Task Updated" : "Task Added"
            );

            await load();

            changed();

        } catch (err) {

            console.error(err);

            notify(
                "error",
                "Save Failed",
                err.message
            );

        } finally {

            saving = false;

            if (btn) {
                btn.disabled = false;
            }
        }
    }

    /* ======================================================
       EDIT TASK
    ====================================================== */

    async function editTask(id) {

        const task = tasks.find(
            x => String(x.task_id) === String(id)
        );

        if (!task) return;

        const ok = await confirmAction({

            icon: "question",

            title: "Edit this task?",

            text:
                `Do you want to edit "${task.title}"?`,

            confirmText: "Yes, edit it"
        });

        if (!ok) return;

        $("taskId").value =
            task.task_id;

        $("taskTitle").value =
            task.title || "";

        $("taskSubject").value =
            task.subject || "";

        $("taskDescription").value =
            task.description || "";

        $("taskPriority").value =
            task.priority;

        $("taskStatus").value =
            task.status === "Overdue"
                ? "Pending"
                : task.status;

        $("taskDeadline").value =
            toInputValue(task.deadline);

        openModal("Edit Task");
    }

    /* ======================================================
       DELETE TASK
    ====================================================== */

    async function deleteTask(id) {

        const task = tasks.find(
            x => String(x.task_id) === String(id)
        );

        const ok = await confirmAction({

            icon: "warning",

            title: "Delete this task?",

            text:
                `"${task?.title || "This task"}" will be deleted. This action cannot be undone.`,

            confirmText: "Yes, delete it",

            confirmColor: "#d33"
        });

        if (!ok) return;

        try {

            await request("/" + id, {
                method: "DELETE"
            });

            notify(
                "success",
                "Task Deleted"
            );

            await load();

            changed();

        } catch (err) {

            notify(
                "error",
                "Delete Failed",
                err.message
            );
        }
    }

    /* ======================================================
       REFRESH
    ====================================================== */

    async function refresh() {

        if (window.Swal) {

            Swal.fire({

                title: "Refreshing...",

                allowOutsideClick: false,

                showConfirmButton: false,

                didOpen: () =>
                    Swal.showLoading(),
            });
        }

        await load();

        if (window.Swal) {
            Swal.close();
        }

        notify(
            "success",
            "Tasks Updated"
        );
    }

    /* ======================================================
       INITIALIZE
       Listeners are bound ONCE.
    ====================================================== */

    function init() {

        if (initialized) return;

        initialized = true;

        /* ---------- STATIC BUTTONS ---------- */

        $("btnAddTask")?.addEventListener(
            "click",
            () => {

                clearForm();

                openModal("Add Task");
            }
        );

        $("btnSaveTask")?.addEventListener(
            "click",
            saveTask
        );

        $("btnRefreshTasks")?.addEventListener(
            "click",
            refresh
        );

        /* ---------- FILTERS ---------- */

        $("searchTask")?.addEventListener(
            "input",
            applyFilters
        );

        $("filterStatus")?.addEventListener(
            "change",
            applyFilters
        );

        $("filterPriority")?.addEventListener(
            "change",
            applyFilters
        );

        /* ---------- ROW BUTTONS ---------- */

        document.addEventListener(
            "click",
            (e) => {

                const edit =
                    e.target.closest(".btn-edit");

                if (edit) {
                    return editTask(
                        edit.dataset.id
                    );
                }

                const del =
                    e.target.closest(".btn-delete");

                if (del) {
                    return deleteTask(
                        del.dataset.id
                    );
                }

            }
        );

        load();
    }

    /* ======================================================
       START
    ====================================================== */

    if (document.readyState === "loading") {

        document.addEventListener(
            "DOMContentLoaded",
            init
        );

    } else {

        init();
    }

    /* ======================================================
       PUBLIC METHODS
    ====================================================== */

    return {
        load,
        refresh: load
    };

})();

</script>