<script>
  (function () {
    var LOGOUT_URL = "/auth/logout";

    function confirmLogout() {
      // Fallback if SweetAlert isn't loaded on this page
      if (typeof Swal === "undefined") {
        if (window.confirm("Are you sure you want to logout?")) {
          window.location.href = LOGOUT_URL;
        }
        return;
      }

      Swal.fire({
        title: "Logout?",
        text: "Are you sure you want to logout?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, logout",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#1f8a56",
        cancelButtonColor: "#858796",
        reverseButtons: true,
        focusCancel: true
      }).then(function (result) {
        if (result.isConfirmed) {
          Swal.fire({
            title: "Logging out...",
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: function () { Swal.showLoading(); }
          });
          window.location.href = LOGOUT_URL;
        }
      });
    }

    // Capture phase: runs before any old click handler on the same item
    document.addEventListener(
      "click",
      function (e) {
        var el = e.target.closest("#btnLogout, [data-logout], a[href$='/logout']");
        if (!el) return;

        e.preventDefault();
        e.stopImmediatePropagation();
        confirmLogout();
      },
      true
    );
  })();
</script>