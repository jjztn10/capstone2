<script>
  (function () {
    var idleTimeoutMs = Number(document.body.getAttribute("data-session-idle-timeout"));
    if (!idleTimeoutMs) return;

    var activityKey = "smartwork:session:last-activity";
    var lastActivityAt = 0;
    var lastStorageWriteAt = 0;
    var lastHeartbeatAt = 0;
    var storageAvailable = true;
    var logoutTimer = null;
    var logoutStarted = false;

    function readStoredActivity() {
      if (!storageAvailable) return 0;

      try {
        return Number(window.localStorage.getItem(activityKey)) || 0;
      } catch (error) {
        storageAvailable = false;
        console.error("Unable to synchronize session activity across tabs.", error);
        return 0;
      }
    }

    function writeStoredActivity(timestamp) {
      if (!storageAvailable || timestamp - lastStorageWriteAt < 15000) return;

      try {
        window.localStorage.setItem(activityKey, String(timestamp));
        lastStorageWriteAt = timestamp;
      } catch (error) {
        storageAvailable = false;
        console.error("Unable to synchronize session activity across tabs.", error);
      }
    }

    function sendActivityHeartbeat(now) {
      if (now - lastHeartbeatAt < 15000) return;
      lastHeartbeatAt = now;

      window.fetch("/auth/activity", {
        method: "POST",
        credentials: "same-origin",
        headers: { "Accept": "application/json" },
        keepalive: true
      }).then(function (response) {
        if (response.status === 401) {
          window.location.replace("/auth");
        } else if (!response.ok) {
          console.error("Session activity request failed with status " + response.status + ".");
        }
      }).catch(function (error) {
        console.error("Unable to refresh the active session.", error);
      });
    }

    function endSessionWhenIdle() {
      clearTimeout(logoutTimer);
      var latestActivityAt = Math.max(lastActivityAt, readStoredActivity());
      var remainingMs = idleTimeoutMs - (Date.now() - latestActivityAt);

      if (remainingMs <= 0) {
        if (logoutStarted) return;
        logoutStarted = true;
        window.location.replace("/auth/logout");
        return;
      }

      logoutTimer = setTimeout(endSessionWhenIdle, remainingMs);
    }

    function recordActivity() {
      if (document.visibilityState === "hidden" || logoutStarted) return;

      var now = Date.now();
      if (lastActivityAt && now - lastActivityAt < 1000) return;

      lastActivityAt = Math.max(now, readStoredActivity());
      writeStoredActivity(lastActivityAt);
      endSessionWhenIdle();
      sendActivityHeartbeat(now);
    }

    window.addEventListener("storage", function (event) {
      if (event.key !== activityKey) return;

      var timestamp = Number(event.newValue);
      if (Number.isFinite(timestamp) && timestamp > lastActivityAt) {
        lastActivityAt = timestamp;
        endSessionWhenIdle();
      }
    });

    ["click", "keydown", "mousemove", "pointerdown", "scroll", "touchstart"].forEach(function (eventName) {
      document.addEventListener(eventName, recordActivity, { passive: true });
    });

    document.addEventListener("visibilitychange", function () {
      if (document.visibilityState === "visible") {
        endSessionWhenIdle();
        if (!logoutStarted) recordActivity();
      }
    });

    lastActivityAt = Math.max(Date.now(), readStoredActivity());
    writeStoredActivity(lastActivityAt);
    endSessionWhenIdle();
    sendActivityHeartbeat(lastActivityAt);
  })();

  (function () {
    var sidebar = document.getElementById("accordionSidebar");
    var toggle = document.getElementById("mobileSidebarToggle");
    var backdrop = document.getElementById("sidebarBackdrop");

    if (!sidebar || !toggle || !backdrop) return;

    function setSidebarOpen(isOpen, restoreFocus) {
      sidebar.classList.toggle("show", isOpen);
      backdrop.hidden = !isOpen;
      document.body.classList.toggle("sidebar-open", isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");

      if (isOpen) {
        var firstLink = sidebar.querySelector(".nav-link");
        if (firstLink) firstLink.focus();
      } else if (restoreFocus && window.matchMedia("(max-width: 991px)").matches) {
        toggle.focus();
      }
    }

    toggle.addEventListener("click", function () {
      setSidebarOpen(!sidebar.classList.contains("show"), true);
    });

    backdrop.addEventListener("click", function () {
      setSidebarOpen(false, true);
    });

    sidebar.addEventListener("click", function (event) {
      if (event.target.closest(".nav-link")) setSidebarOpen(false, true);
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && sidebar.classList.contains("show")) {
        setSidebarOpen(false, true);
      }
    });

    window.addEventListener("resize", function () {
      if (window.innerWidth > 991 && sidebar.classList.contains("show")) {
        setSidebarOpen(false, false);
      }
    });
  })();

  (function () {
    var LOGOUT_URL = "/auth/logout";

    function confirmLogout() {
      // Fallback if SweetAlert isn't loaded on this page
      if (typeof Swal === "undefined") {
        if (window.confirm("Are you sure you want to logout?")) {
          window.location.href = LOGOUT_URL;
        }
        return;
      }

      Swal.fire({
        title: "Logout?",
        text: "Are you sure you want to logout?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, logout",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#1f8a56",
        cancelButtonColor: "#858796",
        reverseButtons: true,
        focusCancel: true
      }).then(function (result) {
        if (result.isConfirmed) {
          Swal.fire({
            title: "Logging out...",
            allowOutsideClick: false,
            showConfirmButton: false,
            didOpen: function () { Swal.showLoading(); }
          });
          window.location.href = LOGOUT_URL;
        }
      });
    }

    // Capture phase: runs before any old click handler on the same item
    document.addEventListener(
      "click",
      function (e) {
        var el = e.target.closest("#btnLogout, [data-logout], a[href$='/logout']");
        if (!el) return;

        e.preventDefault();
        e.stopImmediatePropagation();
        confirmLogout();
      },
      true
    );
  })();
</script>