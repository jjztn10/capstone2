<script>
  (() => {
    "use strict";

    const API = "/admindashboard/api/users";
    const GREEN = "#2d5a3d";
    const $ = (id) => document.getElementById(id);

    const PASSWORD_FIELDS = ["addPassword", "addConfirm", "editPassword", "editConfirm"];

    let users = [];

    const esc = (v) =>
      String(v ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );

    const fmtDate = (v) => {
      if (!v) return "-";
      const d = new Date(v);
      return isNaN(d) ? esc(v) : d.toLocaleDateString();
    };

    function notify(icon, title, html) {
      if (window.Swal) {
        return Swal.fire({
          icon,
          title,
          html: html || "",
          confirmButtonColor: GREEN,
          timer: icon === "success" ? 2500 : undefined,
          timerProgressBar: icon === "success",
        });
      }
      alert(title + (html ? "\n\n" + html.replace(/<[^>]+>/g, " ") : ""));
      return Promise.resolve();
    }

    // Red "danger" confirmation (used for delete)
    async function confirmBox(html) {
      if (window.Swal) {
        const r = await Swal.fire({
          icon: "warning",
          title: "Are you sure?",
          html,
          showCancelButton: true,
          confirmButtonText: "Yes",
          cancelButtonText: "No",
          confirmButtonColor: "#dc3545",
          cancelButtonColor: "#6c757d",
          reverseButtons: true,
          focusCancel: true,
        });
        return r.isConfirmed;
      }
      return confirm("Are you sure?\n\n" + html.replace(/<[^>]+>/g, " "));
    }

    // Green confirmation (used for add / update)
    async function confirmAction(title, html, confirmText) {
      if (window.Swal) {
        const r = await Swal.fire({
          icon: "question",
          title,
          html,
          showCancelButton: true,
          confirmButtonText: confirmText || "Yes",
          cancelButtonText: "Cancel",
          confirmButtonColor: GREEN,
          cancelButtonColor: "#6c757d",
          reverseButtons: true,
        });
        return r.isConfirmed;
      }
      return confirm(title + "\n\n" + (html || "").replace(/<[^>]+>/g, " "));
    }

    async function request(path, options = {}) {
      const res = await fetch(API + path, {
        headers: { "Content-Type": "application/json" },
        ...options,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok)
        throw new Error(data.error || "Request failed (" + res.status + ")");
      return data;
    }

    function modalAction(id, action) {
      const el = $(id);
      if (!el) return console.warn("Modal not found: #" + id);
      if (window.jQuery && window.jQuery.fn && window.jQuery.fn.modal) {
        return window.jQuery(el).modal(action);
      }
      if (window.bootstrap) {
        const m = bootstrap.Modal.getOrCreateInstance(el);
        return action === "show" ? m.show() : m.hide();
      }
    }

    /* ---------- password eye ---------- */

    function setEyeIcon(btn, visible) {
      const icon = btn.matches("i") ? btn : btn.querySelector("i");
      if (!icon) return;
      icon.classList.remove("fa-eye", "fa-eye-slash");
      icon.classList.add(visible ? "fa-eye-slash" : "fa-eye");
    }

    function togglePassword(input, btn) {
      const show = input.type === "password";
      input.type = show ? "text" : "password";
      setEyeIcon(btn, show);
    }

    function setupPasswordEyes() {
      PASSWORD_FIELDS.forEach((id) => {
        const input = $(id);
        if (!input || input.dataset.eyeReady) return;
        input.dataset.eyeReady = "1";

        // Reuse an eye icon that already sits next to the input, if any
        const existingIcon = input.parentElement.querySelector('[class*="fa-eye"]');
        let btn;

        if (existingIcon) {
          const holder =
            existingIcon.closest("button, a, .input-group-text, span") ||
            existingIcon;
          // clone to drop any old broken handlers
          btn = holder.cloneNode(true);
          holder.parentNode.replaceChild(btn, holder);
          btn.style.cursor = "pointer";
          btn.setAttribute("role", "button");
          btn.setAttribute("tabindex", "0");
        } else {
          const wrap = document.createElement("div");
          wrap.style.position = "relative";
          input.parentNode.insertBefore(wrap, input);
          wrap.appendChild(input);
          input.style.paddingRight = "44px";

          btn = document.createElement("button");
          btn.type = "button";
          btn.innerHTML = '<i class="fas fa-eye"></i>';
          btn.setAttribute("aria-label", "Show or hide password");
          btn.style.cssText =
            "position:absolute;top:50%;right:8px;transform:translateY(-50%);" +
            "border:0;background:transparent;color:#6c757d;padding:6px 8px;" +
            "cursor:pointer;line-height:1;";
          wrap.appendChild(btn);
        }

        btn.addEventListener("click", (e) => {
          e.preventDefault();
          e.stopPropagation();
          togglePassword(input, btn);
        });

        btn._eyeInput = input;
      });
    }

    function resetPasswordEyes() {
      PASSWORD_FIELDS.forEach((id) => {
        const input = $(id);
        if (!input) return;
        input.type = "password";
        const holder = input.parentElement;
        const btn = holder && holder.querySelector('[class*="fa-eye"]');
        if (btn) setEyeIcon(btn, false);
      });
    }

    // Modals must live directly under <body>, otherwise they cannot show
    // while the users section is hidden (d-none).
    function moveModalsToBody() {
      ["addUserModal", "editUserModal"].forEach((id) => {
        const el = $(id);
        if (el && el.parentElement !== document.body) {
          document.body.appendChild(el);
        }
      });
    }

    function prepare() {
      moveModalsToBody();
      setupPasswordEyes();
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", prepare);
    } else {
      prepare();
    }

    /* ---------- table + search ---------- */
    function render() {
      const term = ($("usersSearch")?.value || "").trim().toLowerCase();
      const rows = term
        ? users.filter(
            (u) =>
              (u.name || "").toLowerCase().includes(term) ||
              (u.email || "").toLowerCase().includes(term),
          )
        : users;

      if ($("usersCount")) {
        $("usersCount").textContent = term
          ? rows.length + " of " + users.length
          : users.length;
      }

      const body = $("usersTableBody");
      if (!body) return;

      body.innerHTML = rows.length
        ? rows
            .map(
              (u) => `
        <tr>
          <td>${esc(u.name || "-")}</td>
          <td>${esc(u.email)}</td>
          <td>${esc(u.study_streak)}</td>
          <td>${esc(u.total_points)}</td>
          <td>${esc(u.weekly_points)}</td>
          <td>${fmtDate(u.created_at)}</td>
          <td class="text-nowrap">
            <button type="button" class="btn btn-sm btn-outline-success"
                    data-edit-user="${esc(u.uid)}"
                    data-name="${esc(u.name)}" data-email="${esc(u.email)}">Edit</button>
            <button type="button" class="btn btn-sm btn-outline-danger"
                    data-delete-user="${esc(u.uid)}"
                    data-label="${esc(u.name || u.email)}">Delete</button>
          </td>
        </tr>`,
            )
            .join("")
        : '<tr><td colspan="7" class="text-center text-muted py-4">No users found.</td></tr>';
    }

    async function load() {
      try {
        users = await request("");
        render();
      } catch (err) {
        console.error(err);
        notify("error", "Unable to load users", esc(err.message));
      }
    }

    const changed = () =>
      document.dispatchEvent(new CustomEvent("users:changed"));

    /* ---------- search ---------- */
    document.addEventListener("input", (e) => {
      if (e.target && e.target.id === "usersSearch") render();
    });

    /* ---------- add / edit submit ---------- */
    document.addEventListener("submit", async (e) => {
      const form = e.target;

      if (form.id === "addUserForm") {
        e.preventDefault();

        const name = $("addName").value.trim();
        const email = $("addEmail").value.trim();
        const password = $("addPassword").value;

        if (!password) {
          return notify("warning", "Password is required");
        }
        if (password !== $("addConfirm").value) {
          return notify("error", "Passwords do not match");
        }

        const ok = await confirmAction(
          "Add this user?",
          "Are you sure you want to add <b>" +
            esc(name || email) +
            "</b>?<br>" +
            esc(email),
          "Yes, add user",
        );
        if (!ok) return;

        try {
          const created = await request("", {
            method: "POST",
            body: JSON.stringify({ name, email, password }),
          });
          form.reset();
          resetPasswordEyes();
          modalAction("addUserModal", "hide");
          await load();
          changed();
          notify(
            "success",
            "User created!",
            "<b>" +
              esc(created.name || "(no name)") +
              "</b><br>" +
              esc(created.email),
          );
        } catch (err) {
          notify("error", "Could not create user", esc(err.message));
        }
      }

      if (form.id === "editUserForm") {
        e.preventDefault();

        const password = $("editPassword").value;
        if (password !== $("editConfirm").value) {
          return notify("error", "Passwords do not match");
        }

        const name = $("editName").value.trim();
        const email = $("editEmail").value.trim();

        const ok = await confirmAction(
          "Save changes?",
          "Are you sure you want to update <b>" +
            esc(name || email) +
            "</b>?" +
            (password ? "<br>Their password will also be changed." : ""),
          "Yes, save",
        );
        if (!ok) return;

        try {
          const body = { name, email };
          if (password) body.password = password;
          await request("/" + encodeURIComponent($("editUid").value), {
            method: "PUT",
            body: JSON.stringify(body),
          });
          resetPasswordEyes();
          modalAction("editUserModal", "hide");
          await load();
          changed();
          notify("success", "User updated!");
        } catch (err) {
          notify("error", "Could not update user", esc(err.message));
        }
      }
    });

    /* ---------- clicks ---------- */
    document.addEventListener("click", async (e) => {
      if (e.target.closest("#btnAddUser")) {
        setupPasswordEyes();
        resetPasswordEyes();
        return modalAction("addUserModal", "show");
      }

      const edit = e.target.closest("[data-edit-user]");
      if (edit) {
        $("editUid").value = edit.dataset.editUser;
        $("editName").value = edit.dataset.name || "";
        $("editEmail").value = edit.dataset.email || "";
        $("editPassword").value = "";
        $("editConfirm").value = "";
        setupPasswordEyes();
        resetPasswordEyes();
        return modalAction("editUserModal", "show");
      }

      const del = e.target.closest("[data-delete-user]");
      if (del) {
        const ok = await confirmBox(
          "<b>" +
            esc(del.dataset.label || "this user") +
            "</b> and ALL their tasks, sessions, and mood entries will be permanently deleted.",
        );
        if (!ok) return;
        try {
          await request("/" + encodeURIComponent(del.dataset.deleteUser), {
            method: "DELETE",
          });
          await load();
          changed();
          notify("success", "User deleted");
        } catch (err) {
          notify("error", "Could not delete user", esc(err.message));
        }
      }
    });

    window.AdminUsers = { load };
  })();
</script>