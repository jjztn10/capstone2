<script>
window.UserLeaderboard = (() => {

    "use strict";

    const API = "/userdashboard/api/leaderboard";
    const GREEN = "#2d5a3d";

    const $ = (id) => document.getElementById(id);

    let leaderboard = [];
    let busy = false;
    let initialized = false;

    /* ==========================================
       HELPERS
    ========================================== */

    const esc = (v) =>
        String(v ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[c]);

    function notify(icon, title, text = "") {
        if (window.Swal) {
            return Swal.fire({
                icon,
                title,
                text,
                confirmButtonColor: GREEN,
                timer: icon === "success" ? 1500 : undefined,
                timerProgressBar: icon === "success"
            });
        }
        alert(text ? title + "\n" + text : title);
    }

    async function request(path = "", options = {}) {
        const response = await fetch(API + path, {
            headers: { "Content-Type": "application/json" },
            ...options
        });

        const data = await response.json().catch(() => ({}));

        if (!response.ok) {
            throw new Error(data.error || "Request failed (" + response.status + ")");
        }
        return data;
    }

    /* ==========================================
       LOAD  (returns true on success, false on failure)
    ========================================== */

    async function load(silent = false) {
        try {
            const data = await request();
            leaderboard = data.users || [];
            renderTopThree();
            renderTable();
            return true;
        } catch (err) {
            console.error(err);
            if (!silent) notify("error", "Unable to load leaderboard", err.message);
            return false;
        }
    }

    /* ==========================================
       TOP 3
    ========================================== */

    function renderTopThree() {
        const top = leaderboard.slice(0, 3);
        const set = (id, v) => { if ($(id)) $(id).textContent = v; };

        set("firstUser",  top[0]?.name || "-");
        set("firstScore", (top[0]?.productivity || 0) + "%");

        set("secondUser",  top[1]?.name || "-");
        set("secondScore", (top[1]?.productivity || 0) + "%");

        set("thirdUser",  top[2]?.name || "-");
        set("thirdScore", (top[2]?.productivity || 0) + "%");
    }

    /* ==========================================
       LEADERBOARD TABLE
    ========================================== */

    function renderTable() {
        const tbody = $("leaderboardTableBody");
        if (!tbody) return;

        if ($("leaderboardCount")) {
            $("leaderboardCount").textContent = leaderboard.length + " Users";
        }

        if (!leaderboard.length) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        No leaderboard data found.
                    </td>
                </tr>`;
            return;
        }

        tbody.innerHTML = leaderboard.map((user, index) => `
            <tr>
                <td>${index === 0 ? "🥇" : index === 1 ? "🥈" : index === 2 ? "🥉" : "#" + (index + 1)}</td>
                <td>${esc(user.name)}</td>
                <td>${esc(user.email)}</td>
                <td>${esc(user.completedTasks || 0)}</td>
                <td>${esc(user.studyHours || 0)}</td>
                <td><span class="badge badge-success">${esc(user.productivity || 0)}%</span></td>
            </tr>
        `).join("");
    }

    /* ==========================================
       REFRESH
    ========================================== */

    async function refresh() {
        if (busy) return;
        busy = true;

        const btn = $("btnRefreshLeaderboard");
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Refreshing...';
        }

        if (window.Swal) {
            Swal.fire({
                title: "Refreshing...",
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });
        }

        const ok = await load(true);

        if (window.Swal) Swal.close();

        if (ok) {
            notify("success", "Leaderboard updated.");
        } else {
            notify("error", "Unable to refresh leaderboard", "Please try again.");
        }

        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-sync-alt"></i> Refresh';
        }

        busy = false;
    }

    /* ==========================================
       INIT  (runs once, after the DOM exists)
    ========================================== */

    function init() {
        if (initialized) return;
        initialized = true;

        // delegation: works even if the button is added or replaced later
        document.addEventListener("click", (e) => {
            if (e.target.closest("#btnRefreshLeaderboard")) {
                e.preventDefault();
                refresh();
            }
        });

        load();
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", init);
    } else {
        init();
    }

    /* ==========================================
       PUBLIC METHODS
    ========================================== */

    return { load, refresh };

})();
</script>