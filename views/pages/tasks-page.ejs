<%# views/pages/tasks-page.ejs : complete page (markup + styles). No tasks.css needed. %>

<style>
/* ==========================================================
   TASKS PAGE : matches the dashboard look
========================================================== */

/* ---------- HERO ---------- */
body#page-top .tk-hero{
    position:relative;
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:16px;
    padding:26px 30px;
    margin-bottom:26px;
    border-radius:18px;
    border-left:6px solid #1f6b3f;
    background:
        radial-gradient(circle at 92% 15%, rgba(34,165,90,.16), transparent 38%),
        #fff;
    box-shadow:0 8px 28px rgba(20,48,31,.08);
}

body#page-top .tk-hero-left{
    display:flex;
    align-items:center;
    gap:20px;
}

body#page-top .tk-hero-icon{
    width:56px;
    height:56px;
    flex:0 0 56px;
    display:flex;
    align-items:center;
    justify-content:center;
    border-radius:16px;
    background:linear-gradient(135deg,#22a55a,#1f6b3f);
    color:#fff;
    font-size:1.5rem;
    box-shadow:0 8px 18px rgba(31,107,63,.35);
}

body#page-top .tk-eyebrow{
    font-size:.72rem;
    font-weight:700;
    letter-spacing:.14em;
    text-transform:uppercase;
    color:#22a55a;
    margin-bottom:2px;
}

body#page-top .tk-title{
    margin:0;
    font-size:1.9rem;
    font-weight:800;
    color:#14301f;
    line-height:1.15;
}

body#page-top .tk-title span{
    color:#22a55a;
}

body#page-top .tk-sub{
    margin:4px 0 0;
    color:#6b7a70;
    font-size:.95rem;
}

body#page-top .tk-hero-right{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:12px;
}

body#page-top .tk-date{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    border-radius:999px;
    background:#e9f4ec;
    color:#1f5233;
    font-weight:600;
    font-size:.9rem;
}

/* ---------- BUTTONS ---------- */
body#page-top .tk-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:12px 22px;
    border-radius:12px;
    border:none !important;
    color:#fff !important;
    font-weight:700;
    font-size:.95rem;
    background:linear-gradient(135deg,#2d5a3d,#1b3d2b) !important;
    box-shadow:0 8px 18px rgba(27,61,43,.28);
    transition:transform .15s ease, box-shadow .15s ease;
}

body#page-top .tk-btn:hover{
    transform:translateY(-1px);
    box-shadow:0 12px 22px rgba(27,61,43,.34);
}

body#page-top .tk-btn.tk-btn-add{
    background:linear-gradient(135deg,#22a55a,#1f8f4d) !important;
    box-shadow:0 8px 18px rgba(34,165,90,.32);
}

/* ---------- STAT CARDS ---------- */
body#page-top .tk-stat{
    position:relative;
    display:flex;
    align-items:center;
    justify-content:space-between;
    height:100%;
    padding:22px 26px;
    border-radius:16px;
    background:#fff;
    border-left:6px solid var(--c);
    box-shadow:0 6px 22px rgba(20,48,31,.07);
}

body#page-top .tk-stat.blue{
    --c:#3b6fe0;
}

body#page-top .tk-stat.amber{
    --c:#f0a010;
}

body#page-top .tk-stat.green{
    --c:#22a55a;
}

body#page-top .tk-stat.red{
    --c:#e5484d;
}

body#page-top .tk-stat .tk-label{
    font-size:.78rem;
    font-weight:800;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--c);
}

body#page-top .tk-stat .tk-value,
body#page-top .tk-stat #totalTasks,
body#page-top .tk-stat #pendingCount,
body#page-top .tk-stat #completedCount,
body#page-top .tk-stat #overdueCount{
    display:block;
    margin-top:8px;
    font-size:2.3rem !important;
    font-weight:800 !important;
    line-height:1 !important;
    color:#14301f !important;
}

body#page-top .tk-stat .tk-ico{
    font-size:2.1rem;
    color:var(--c);
    opacity:.28;
}

/* ---------- LIST CARD ---------- */
body#page-top .tk-card{
    border-radius:16px;
    background:#fff;
    box-shadow:0 6px 22px rgba(20,48,31,.07);
    overflow:hidden;
}

body#page-top .tk-card-head{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    padding:20px 28px;
    border-bottom:1px solid #e8ece6;
}

body#page-top .tk-card-head h5{
    margin:0;
    font-weight:800;
    font-size:1.05rem;
    color:#1f5233;
}

body#page-top .tk-card-body{
    padding:24px 28px 28px;
}

/* ---------- FILTERS ---------- */
body#page-top .tk-filters .form-control{
    height:46px;
    border-radius:12px;
    border:1px solid #d9dfd7;
    background:#fff;
    box-shadow:none;
}

body#page-top .tk-filters .form-control:focus{
    border-color:#22a55a;
    box-shadow:0 0 0 .2rem rgba(34,165,90,.15);
}

/* ---------- TABLE ---------- */
body#page-top .tk-table{
    margin:0;
}

body#page-top .tk-table thead th{
    background:#eef5f0 !important;
    color:#1f5233 !important;
    border:none !important;
    padding:14px 16px;
    font-size:.74rem;
    font-weight:800;
    letter-spacing:.08em;
    text-transform:uppercase;
}

body#page-top .tk-table thead th:first-child{
    border-radius:12px 0 0 12px;
}

body#page-top .tk-table thead th:last-child{
    border-radius:0 12px 12px 0;
}

body#page-top .tk-table tbody td{
    padding:16px;
    vertical-align:middle;
    border-top:1px solid #eef1ec;
    color:#4b5a50;
}

body#page-top .tk-table tbody tr:first-child td{
    border-top:none;
}

body#page-top .tk-table tbody tr:hover{
    background:#f6faf7;
}

body#page-top .tk-table tbody td strong{
    color:#14301f;
    font-weight:700;
}

/* ---------- STATUS / PRIORITY PILLS ---------- */
body#page-top #taskTableBody .badge{
    display:inline-block !important;
    padding:.5em 1em !important;
    border-radius:999px !important;
    font-size:.74rem !important;
    font-weight:700 !important;
    letter-spacing:.03em;
}

body#page-top #taskTableBody .badge.priority-high{
    background:#fde8ea !important;
    color:#b4232f !important;
}

body#page-top #taskTableBody .badge.priority-medium{
    background:#fff3d1 !important;
    color:#8a5d00 !important;
}

body#page-top #taskTableBody .badge.priority-low{
    background:#e3f2e8 !important;
    color:#1a7f45 !important;
}

body#page-top #taskTableBody .badge-success{
    background:#e3f6ea !important;
    color:#1a7f45 !important;
}

body#page-top #taskTableBody .badge-warning{
    background:#fff3d1 !important;
    color:#8a5d00 !important;
}

body#page-top #taskTableBody .badge-danger{
    background:#fde8ea !important;
    color:#b4232f !important;
}

body#page-top #taskTableBody .badge-primary{
    background:#e3ecff !important;
    color:#2a52be !important;
}

body#page-top #taskTableBody .badge-secondary{
    background:#eceff1 !important;
    color:#5b6670 !important;
}

/* ---------- ROW ACTION BUTTONS ---------- */
body#page-top #taskTableBody .btn-sm{
    width:36px;
    height:36px;
    padding:0;
    border:none !important;
    border-radius:10px;
    margin-left:6px;
    box-shadow:none;
}

body#page-top #taskTableBody .btn-edit{
    background:#e3ecff !important;
    color:#2a52be !important;
}

body#page-top #taskTableBody .btn-delete{
    background:#fde8ea !important;
    color:#b4232f !important;
}

body#page-top #taskTableBody .btn-edit:hover{
    background:#2a52be !important;
    color:#fff !important;
}

body#page-top #taskTableBody .btn-delete:hover{
    background:#b4232f !important;
    color:#fff !important;
}

/* ---------- MODAL ---------- */
body#page-top #taskModal .modal-content{
    border:none !important;
    border-radius:18px !important;
    overflow:hidden;
    box-shadow:0 25px 60px rgba(0,0,0,.25);
}

body#page-top #taskModal .modal-header{
    background:linear-gradient(135deg,#14301f,#2d5a3d) !important;
    border:none !important;
    color:#fff !important;
    padding:22px 28px;
}

body#page-top #taskModal .modal-title{
    color:#fff !important;
    font-size:1.4rem;
    font-weight:700;
}

body#page-top #taskModal .close{
    color:#fff !important;
    opacity:1;
    text-shadow:none;
}

body#page-top #taskModal .modal-body{
    padding:28px;
    background:#fff;
}

body#page-top #taskModal label{
    color:#14301f;
    font-weight:600;
    margin-bottom:8px;
}

body#page-top #taskModal .form-control{
    border-radius:12px;
    border:1px solid #d9dfd7;
    min-height:48px;
    box-shadow:none;
}

body#page-top #taskModal textarea.form-control{
    min-height:120px;
}

body#page-top #taskModal .form-control:focus{
    border-color:#22a55a;
    box-shadow:0 0 0 .2rem rgba(34,165,90,.15);
}

body#page-top #taskModal .modal-footer{
    border:none;
    background:#fafafa;
    padding:18px 28px;
}

body#page-top #taskModal .btn-secondary{
    background:#9096a3;
    border:none;
    border-radius:10px;
}

body#page-top #btnSaveTask{
    background:linear-gradient(135deg,#22a55a,#1f8f4d) !important;
    border:none !important;
    color:#fff !important;
    border-radius:10px;
    font-weight:700;
    padding:10px 24px;
}
</style>

<!-- ==========================================================
     HERO
========================================================== -->
<div class="tk-hero">
    <div class="tk-hero-left">

        <div class="tk-hero-icon">
            <i class="fas fa-tasks"></i>
        </div>

        <div>
            <div class="tk-eyebrow">
                <i class="fas fa-bolt"></i> Task Manager
            </div>

            <h1 class="tk-title">
                My <span>Tasks</span>
            </h1>

            <p class="tk-sub">
                Plan, prioritize and finish what matters.
            </p>
        </div>

    </div>

    <div class="tk-hero-right">

        <span class="tk-date">
            <i class="far fa-calendar-alt"></i>
            <span id="taskToday"></span>
        </span>

        <button type="button" id="btnRefreshTasks" class="tk-btn">
            <i class="fas fa-sync-alt"></i>
            Refresh
        </button>

        <button type="button" id="btnAddTask" class="tk-btn tk-btn-add">
            <i class="fas fa-plus"></i>
            Add Task
        </button>

    </div>
</div>

<!-- ==========================================================
     SUMMARY
========================================================== -->
<div class="row mb-4">

    <div class="col-6 col-xl-3 mb-3">
        <div class="tk-stat blue">
            <div>
                <div class="tk-label">Total Tasks</div>
                <span class="tk-value" id="totalTasks">0</span>
            </div>

            <i class="fas fa-clipboard-list tk-ico"></i>
        </div>
    </div>

    <div class="col-6 col-xl-3 mb-3">
        <div class="tk-stat amber">
            <div>
                <div class="tk-label">Pending</div>
                <span class="tk-value" id="pendingCount">0</span>
            </div>

            <i class="fas fa-hourglass-half tk-ico"></i>
        </div>
    </div>

    <div class="col-6 col-xl-3 mb-3">
        <div class="tk-stat green">
            <div>
                <div class="tk-label">Completed</div>
                <span class="tk-value" id="completedCount">0</span>
            </div>

            <i class="fas fa-check-circle tk-ico"></i>
        </div>
    </div>

    <div class="col-6 col-xl-3 mb-3">
        <div class="tk-stat red">
            <div>
                <div class="tk-label">Overdue</div>
                <span class="tk-value" id="overdueCount">0</span>
            </div>

            <i class="fas fa-exclamation-triangle tk-ico"></i>
        </div>
    </div>

</div>

<!-- ==========================================================
     TASK LIST
========================================================== -->
<div class="tk-card">

    <div class="tk-card-head">
        <h5>All Tasks</h5>
    </div>

    <div class="tk-card-body">

        <div class="form-row tk-filters mb-4">

            <div class="col-md-6 mb-2">
                <input
                    type="text"
                    id="searchTask"
                    class="form-control"
                    placeholder="Search by title or subject..."
                >
            </div>

            <div class="col-md-3 mb-2">
                <select id="filterStatus" class="form-control">
                    <option value="">All statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="In Progress">In Progress</option>
                    <option value="Completed">Completed</option>
                    <option value="Overdue">Overdue</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <select id="filterPriority" class="form-control">
                    <option value="">All priorities</option>
                    <option value="High">High</option>
                    <option value="Medium">Medium</option>
                    <option value="Low">Low</option>
                </select>
            </div>

        </div>

        <div class="table-responsive">

            <table class="table tk-table">

                <thead>
                    <tr>
                        <th>Task</th>
                        <th>Subject</th>
                        <th>Priority</th>
                        <th>Deadline</th>
                        <th>Status</th>
                        <th class="text-right">Actions</th>
                    </tr>
                </thead>

                <tbody id="taskTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            Loading tasks...
                        </td>
                    </tr>
                </tbody>

            </table>

        </div>

    </div>
</div>

<!-- ==========================================================
     ADD / EDIT MODAL
========================================================== -->
<div
    class="modal fade"
    id="taskModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="taskModalTitle"
    aria-hidden="true"
>

    <div class="modal-dialog modal-dialog-centered" role="document">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="taskModalTitle">
                    Add Task
                </h5>

                <button
                    type="button"
                    class="close"
                    data-dismiss="modal"
                    aria-label="Close"
                >
                    <span aria-hidden="true">&times;</span>
                </button>

            </div>

            <div class="modal-body">

                <input type="hidden" id="taskId">

                <div class="form-group">
                    <label for="taskTitle">Title</label>
                    <input
                        type="text"
                        id="taskTitle"
                        class="form-control"
                        maxlength="255"
                    >
                </div>

                <div class="form-group">
                    <label for="taskSubject">Subject</label>
                    <input
                        type="text"
                        id="taskSubject"
                        class="form-control"
                        maxlength="120"
                    >
                </div>

                <div class="form-group">
                    <label for="taskDescription">Description</label>
                    <textarea
                        id="taskDescription"
                        class="form-control"
                    ></textarea>
                </div>

                <div class="form-row">

                    <div class="form-group col-md-6">

                        <label for="taskPriority">
                            Priority
                        </label>

                        <select
                            id="taskPriority"
                            class="form-control"
                        >
                            <option value="Low">Low</option>
                            <option value="Medium" selected>
                                Medium
                            </option>
                            <option value="High">High</option>
                        </select>

                    </div>

                    <div class="form-group col-md-6">

                        <label for="taskStatus">
                            Status
                        </label>

                        <select
                            id="taskStatus"
                            class="form-control"
                        >
                            <option value="Pending" selected>
                                Pending
                            </option>

                            <option value="In Progress">
                                In Progress
                            </option>

                            <option value="Completed">
                                Completed
                            </option>
                        </select>

                    </div>

                </div>

                <div class="form-group mb-0">

                    <label for="taskDeadline">
                        Deadline (date and time)
                    </label>

                    <input
                        type="datetime-local"
                        id="taskDeadline"
                        class="form-control"
                    >

                </div>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-dismiss="modal"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    id="btnSaveTask"
                    class="btn"
                >
                    Save Task
                </button>

            </div>

        </div>

    </div>

</div>

<script>
    // Today's date in the hero pill
    (function () {

        var el = document.getElementById("taskToday");

        if (el) {

            el.textContent = new Date().toLocaleDateString(undefined, {
                weekday: "long",
                year: "numeric",
                month: "long",
                day: "numeric"
            });

        }

    })();
</script>