<%
    const summaryCards = [
        { id: "pendingTasks",   label: "Pending Tasks",   value: "0",      icon: "fas fa-clipboard-list", color: "primary" },
        { id: "completedTasks", label: "Completed Tasks", value: "0",      icon: "fas fa-check-circle",   color: "success" },
        { id: "studyHours",     label: "Study Hours",     value: "0.0 hrs", icon: "fas fa-book-reader",    color: "warning" },
        { id: "burnoutRisk",    label: "Burnout Risk",    value: "LOW",    icon: "fas fa-fire",           color: "danger" }
    ];
%>

<div class="container-fluid">

    <!-- WELCOME BANNER (name is filled into #userName by the dashboard script,
         refresh button keeps id="btnRefreshDashboard") -->
    <%- include("../components/welcome", {
        layoutType: "user",
        refreshId: "btnRefreshDashboard"
    }) %>

    <!-- Summary Cards -->
    <div class="row">

        <% summaryCards.forEach(card => { %>
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card shadow border-left-<%= card.color %> h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">

                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-<%= card.color %> text-uppercase mb-1">
                                    <%= card.label %>
                                </div>
                                <div class="h4 mb-0 font-weight-bold text-gray-800" id="<%= card.id %>">
                                    <%= card.value %>
                                </div>
                            </div>

                            <div class="col-auto">
                                <i class="<%= card.icon %> fa-2x text-gray-300"></i>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        <% }) %>

    </div>

    <!-- Charts -->
    <div class="row">

        <div class="col-lg-8 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">Weekly Study Time</h6>
                </div>
                <div class="card-body">
                    <div style="position: relative; height: 300px;">
                        <canvas id="studyChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card chart-card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">Today's Mood</h6>
                </div>
                <div class="card-body text-center">
                    <h1 id="todayMood">🙂</h1>
                    <h5 id="todayMoodText">Loading...</h5>
                </div>
            </div>
        </div>

    </div>

    <!-- Recent Tasks -->
    <div class="card shadow">

        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-success">Recent Tasks</h6>
            <a href="/userdashboard/tasks" class="btn btn-success btn-sm">View All</a>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Deadline</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="recentTaskTable">
                        <tr>
                            <td colspan="4" class="text-center text-muted">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>