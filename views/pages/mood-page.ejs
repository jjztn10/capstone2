<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">Mood Tracker</h1>
            <p class="text-muted mb-0">Record your daily mood and stress level.</p>
        </div>

        <button id="btnRefreshMood" class="btn btn-success">
            <i class="fas fa-sync-alt"></i>
            Refresh
        </button>
    </div>

    <!-- Summary Cards -->
    <div class="row mb-4">

        <div class="col-md-4 mb-3">
            <div class="card shadow border-left-success h-100">
                <div class="card-body">
                    <div class="text-xs text-success text-uppercase font-weight-bold mb-1">
                        Today's Mood
                    </div>
                    <div class="h4 mb-0 font-weight-bold">
                        <span id="todayMood">🙂</span>
                        <span id="todayMoodText">No Mood Logged</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow border-left-warning h-100">
                <div class="card-body">
                    <div class="text-xs text-warning text-uppercase font-weight-bold mb-1">
                        Stress Level
                    </div>
                    <div id="todayStress" class="h4 mb-0 font-weight-bold">
                        0 / 10
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-3">
            <div class="card shadow border-left-primary h-100">
                <div class="card-body">
                    <div class="text-xs text-primary text-uppercase font-weight-bold mb-1">
                        Entries
                    </div>
                    <div id="totalEntries" class="h4 mb-0 font-weight-bold">
                        0
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Add Entry -->
    <div class="card shadow mb-4">

        <div class="card-header">
            <strong>Daily Check-in</strong>
        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 form-group">
                    <label for="mood">Mood</label>
                    <select id="mood" class="form-control">
                        <option value="happy">😊 Happy</option>
                        <option value="neutral">😐 Neutral</option>
                        <option value="sad">😔 Sad</option>
                        <option value="stressed">😣 Stressed</option>
                        <option value="frustrated">😤 Frustrated</option>
                    </select>
                </div>

                <div class="col-md-4 form-group">
                    <label for="stressLevel">Stress Level (1-10)</label>
                    <input id="stressLevel" type="number" min="1" max="10" value="5" class="form-control">
                </div>

                <div class="col-md-4 form-group">
                    <label for="workload">Workload (1-10)</label>
                    <input id="workload" type="number" min="1" max="10" value="5" class="form-control">
                </div>

            </div>

            <div class="form-group">
                <label for="moodNotes">Notes</label>
                <textarea id="moodNotes" rows="3" maxlength="500" class="form-control"></textarea>
            </div>

            <button id="btnSaveMood" class="btn btn-success">
                <i class="fas fa-save"></i>
                Save Entry
            </button>

        </div>

    </div>

    <!-- History -->
    <div class="card shadow">

        <div class="card-header">
            <strong>Mood History</strong>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead class="thead-light">
                        <tr>
                            <th>Date</th>
                            <th>Mood</th>
                            <th>Stress</th>
                            <th>Workload</th>
                            <th>Notes</th>
                        </tr>
                    </thead>

                    <tbody id="moodTableBody">
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                Loading...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>
        </div>

    </div>

</div>