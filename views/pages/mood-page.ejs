<%- include("../components/page-theme") %>

<div class="pg-page">

    <!-- HERO -->
    <div class="pg-hero">
        <div class="pg-hero-left">
            <div class="pg-hero-icon"><i class="far fa-smile"></i></div>
            <div>
                <div class="pg-eyebrow"><i class="fas fa-heartbeat"></i> Wellness</div>
                <h1 class="pg-title">Mood <span>Tracker</span></h1>
                <p class="pg-sub">Your daily mood and stress level.</p>
            </div>
        </div>
        <div class="pg-hero-right">
            <span class="pg-date"><i class="far fa-calendar-alt"></i> <span data-today></span></span>
            <button id="btnRefreshMood" class="btn pg-btn">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="row mb-4">
        <div class="col-md-4 mb-3">
            <div class="pg-stat green">
                <div>
                    <div class="pg-label">Today's Mood</div>
                    <span class="pg-value sm">
                        <span id="todayMood">🙂</span>
                        <span id="todayMoodText">No Mood Logged</span>
                    </span>
                </div>
                <i class="far fa-smile pg-ico"></i>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="pg-stat amber">
                <div>
                    <div class="pg-label">Stress Level</div>
                    <span class="pg-value" id="todayStress">0 / 10</span>
                </div>
                <i class="fas fa-bolt pg-ico"></i>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="pg-stat blue">
                <div>
                    <div class="pg-label">Entries</div>
                    <span class="pg-value" id="totalEntries">0</span>
                </div>
                <i class="fas fa-clipboard-list pg-ico"></i>
            </div>
        </div>
    </div>

    <!-- STRESS GRAPH -->
    <div class="pg-card">
        <div class="pg-card-head">
            <h5>Daily Stress Level</h5>
            <div class="btn-group btn-group-sm pg-range" id="moodRange">
                <button type="button" class="btn btn-outline-success" data-days="7">7 days</button>
                <button type="button" class="btn btn-outline-success active" data-days="30">30 days</button>
                <button type="button" class="btn btn-outline-success" data-days="90">90 days</button>
            </div>
        </div>
        <div class="pg-card-body">
            <div style="position: relative; height: 320px;">
                <canvas id="stressChart"></canvas>
            </div>
            <p id="stressChartEmpty" class="text-center text-muted mt-3 mb-0 d-none">
                No mood entries in this period yet.
            </p>
        </div>
    </div>

    <!-- HISTORY -->
    <div class="pg-card">
        <div class="pg-card-head">
            <h5>Mood History</h5>
        </div>
        <div class="pg-card-body flush">
            <div class="table-responsive">
                <table class="table pg-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Mood</th>
                            <th>Stress</th>
                            <th>Workload</th>
                            <th>Notes</th>
                        </tr>
                    </thead>
                    <tbody id="moodTableBody">
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>