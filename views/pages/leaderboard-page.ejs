<%- include("../components/page-theme") %>

<div class="pg-page">

    <!-- HERO -->
    <div class="pg-hero">
        <div class="pg-hero-left">
            <div class="pg-hero-icon"><i class="fas fa-trophy"></i></div>
            <div>
                <div class="pg-eyebrow"><i class="fas fa-bolt"></i> Rankings</div>
                <h1 class="pg-title">Leader<span>board</span></h1>
                <p class="pg-sub">See the top performing users based on productivity.</p>
            </div>
        </div>
        <div class="pg-hero-right">
            <span class="pg-date"><i class="far fa-calendar-alt"></i> <span data-today></span></span>
            <button id="btnRefreshLeaderboard" class="btn pg-btn">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- TOP 3 -->
    <div class="row mb-4">
        <div class="col-lg-4 mb-3">
            <div class="pg-podium gold">
                <span class="pg-medal-icon">🥇</span>
                <div class="pg-medal">First Place</div>
                <h3 id="firstUser">-</h3>
                <h5 id="firstScore">0 pts</h5>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="pg-podium silver">
                <span class="pg-medal-icon">🥈</span>
                <div class="pg-medal">Second Place</div>
                <h3 id="secondUser">-</h3>
                <h5 id="secondScore">0 pts</h5>
            </div>
        </div>

        <div class="col-lg-4 mb-3">
            <div class="pg-podium bronze">
                <span class="pg-medal-icon">🥉</span>
                <div class="pg-medal">Third Place</div>
                <h3 id="thirdUser">-</h3>
                <h5 id="thirdScore">0 pts</h5>
            </div>
        </div>
    </div>

    <!-- RANKINGS TABLE -->
    <div class="pg-card">
        <div class="pg-card-head">
            <h6>Productivity Rankings</h6>
            <span id="leaderboardCount" class="badge badge-success">0 Users</span>
        </div>

        <div class="pg-card-body flush">
            <div class="table-responsive">
                <table class="table pg-table">
                    <thead>
                        <tr>
                            <th width="80">Rank</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Tasks</th>
                            <th>Study Hours</th>
                            <th>Productivity</th>
                        </tr>
                    </thead>
                    <tbody id="leaderboardTableBody">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">Loading leaderboard...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>