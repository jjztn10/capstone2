
<!-- ==========================================
     WORK SESSIONS
========================================== -->
<%
const stats =
    (typeof sessionStats !== "undefined" && sessionStats)
        ? sessionStats
        : {
            active: 0,
            completed: 0,
            cancelled: 0,
            total: 0,
            averageHours: 0,
            productivity: 0
        };

const sessions =
    (typeof sessionLogs !== "undefined" && Array.isArray(sessionLogs))
        ? sessionLogs
        : [];
%>
<section
    id="sessions"
    class="admin-section">

    <!-- ==========================
         PAGE HEADER
    =========================== -->

    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>

            <h2 class="h3 mb-1 text-gray-800">

                <i class="fas fa-clock mr-2"></i>

                Work Sessions

            </h2>

            <p class="text-muted mb-0">

                Monitor employee work sessions, productivity, and attendance.

            </p>

        </div>

        <button
            id="btnRefreshSessions"
            class="btn btn-primary shadow">

            <i class="fas fa-sync-alt mr-2"></i>

            Refresh

        </button>

    </div>

    <!-- ==========================
         SUMMARY CARDS
    =========================== -->

    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-left-primary shadow h-100 py-2">

                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">

                                Active Sessions

                            </div>

                            <div class="h4 font-weight-bold text-gray-800">

                                <%= stats ? stats.active : 0 %>

                            </div>

                        </div>

                        <div class="col-auto">

                            <i class="fas fa-play-circle fa-2x text-gray-300"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-left-success shadow h-100 py-2">

                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">

                                Completed

                            </div>

                            <div class="h4 font-weight-bold text-gray-800">

                                <%= stats ? stats.completed : 0 %>

                            </div>

                        </div>

                        <div class="col-auto">

                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-left-warning shadow h-100 py-2">

                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">

                                Average Hours

                            </div>

                            <div class="h4 font-weight-bold text-gray-800">

                                <%= stats ? stats.averageHours : 0 %> hrs

                            </div>

                        </div>

                        <div class="col-auto">

                            <i class="fas fa-hourglass-half fa-2x text-gray-300"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card border-left-info shadow h-100 py-2">

                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">

                                Productivity

                            </div>

                            <div class="h4 font-weight-bold text-gray-800">

                                <%= stats ? stats.productivity : 0 %>%

                            </div>

                        </div>

                        <div class="col-auto">

                            <i class="fas fa-chart-line fa-2x text-gray-300"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ==========================
         SEARCH & FILTER
    =========================== -->

    <div class="card shadow mb-4">

        <div class="card-body">

            <div class="row">

                <div class="col-md-4 mb-3">

                    <input
                        type="text"
                        id="searchSession"
                        class="form-control"
                        placeholder="Search employee...">

                </div>

                <div class="col-md-3 mb-3">

                    <select
                        id="sessionStatusFilter"
                        class="form-control">

                        <option value="">All Status</option>
                        <option value="Active">Active</option>
                        <option value="Completed">Completed</option>
                        <option value="Paused">Paused</option>

                    </select>

                </div>

                <div class="col-md-2 mb-3">

                    <button
                        id="btnSearchSession"
                        class="btn btn-primary btn-block">

                        <i class="fas fa-search mr-2"></i>

                        Search

                    </button>

                </div>

                <div class="col-md-2 mb-3">

                    <button
                        id="btnResetSession"
                        class="btn btn-secondary btn-block">

                        <i class="fas fa-redo mr-2"></i>

                        Reset

                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- ==========================
         SESSION TABLE
    =========================== -->

    <div class="card shadow">

        <div class="card-header py-3">

            <h6 class="m-0 font-weight-bold text-primary">

                Employee Sessions

            </h6>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table
                    class="table table-bordered table-hover"
                    id="sessionTable">

                    <thead class="thead-light">

                        <tr>

                            <th>#</th>
                            <th>Employee</th>
                            <th>Date</th>
                            <th>Start Time</th>
                            <th>End Time</th>
                            <th>Total Hours</th>
                            <th>Status</th>
                            <th class="text-center" width="120">

                                Actions

                            </th>

                        </tr>

                    </thead>

                    <tbody id="sessionTableBody">

                        <% if (sessions && sessions.length > 0) { %>

                            <% sessions.forEach((session, index) => { %>

                                <tr>

                                    <td>

                                        <%= index + 1 %>

                                    </td>

                                    <td>

                                        <strong>

                                            <%= session.employee %>

                                        </strong>

                                    </td>

                                    <td>

                                        <%= session.date %>

                                    </td>

                                    <td>

                                        <%= session.startTime %>

                                    </td>

                                    <td>

                                        <%= session.endTime || "-" %>

                                    </td>

                                    <td>

                                        <%= session.totalHours || "0.0" %>

                                    </td>

                                    <td>

                                        <% if (session.status === "Active") { %>

                                            <span class="badge badge-success">

                                                Active

                                            </span>

                                        <% } else if (session.status === "Paused") { %>

                                            <span class="badge badge-warning">

                                                Paused

                                            </span>

                                        <% } else { %>

                                            <span class="badge badge-secondary">

                                                Completed

                                            </span>

                                        <% } %>

                                    </td>

                                    <td class="text-center">

                                        <button
                                            class="btn btn-sm btn-info btn-view-session"
                                            data-id="<%= session.id %>"
                                            title="View">

                                            <i class="fas fa-eye"></i>

                                        </button>

                                        <button
                                            class="btn btn-sm btn-primary btn-edit-session"
                                            data-id="<%= session.id %>"
                                            title="Edit">

                                            <i class="fas fa-edit"></i>

                                        </button>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } else { %>

                            <tr>

                                <td
                                    colspan="8"
                                    class="text-center py-5 text-muted">

                                    <i class="fas fa-clock fa-3x mb-3 d-block"></i>

                                    No work sessions found.

                                </td>

                            </tr>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </div>

        <div class="card-footer bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <small class="text-muted">

                    Showing

                    <strong>

                        <%= sessions ? sessions.length : 0 %>

                    </strong>

                    session(s)

                </small>

                <nav>

                    <ul
                        class="pagination pagination-sm mb-0"
                        id="sessionPagination">

                        <!-- Pagination generated by JavaScript -->

                    </ul>

                </nav>

            </div>

        </div>

    </div>

</section>
