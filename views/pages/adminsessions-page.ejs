<section id="sessions" class="admin-section">
  <div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
      <h2 class="h3 mb-1 text-gray-800">
        <i class="fas fa-clock mr-2"></i>Work Sessions
      </h2>
      <p class="text-muted mb-0">
        Monitor student study sessions, productivity, and attendance.
      </p>
    </div>
    <div class="d-flex align-items-center">
      <select id="sessionRange" class="form-control mr-2" style="width: auto">
        <option value="7">Last 7 days</option>
        <option value="30" selected>Last 30 days</option>
        <option value="90">Last 90 days</option>
        <option value="0">All time</option>
      </select>
      <button
        id="btnAddSession"
        type="button"
        class="btn btn-primary shadow mr-2"
      >
        <i class="fas fa-plus mr-2"></i>Add Session
      </button>
      <button
        id="btnRefreshSessions"
        type="button"
        class="btn btn-outline-primary shadow-sm"
      >
        <i class="fas fa-sync-alt mr-2"></i>Refresh
      </button>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div
                class="text-xs font-weight-bold text-primary text-uppercase mb-1"
              >
                Active Sessions
              </div>
              <div class="h4 font-weight-bold text-gray-800" id="sessActive">
                0
              </div>
            </div>
            <div class="col-auto">
              <i class="fas fa-play-circle fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div
                class="text-xs font-weight-bold text-success text-uppercase mb-1"
              >
                Completed
              </div>
              <div class="h4 font-weight-bold text-gray-800" id="sessCompleted">
                0
              </div>
            </div>
            <div class="col-auto">
              <i class="fas fa-check-circle fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div
                class="text-xs font-weight-bold text-warning text-uppercase mb-1"
              >
                Average Hours
              </div>
              <div class="h4 font-weight-bold text-gray-800">
                <span id="sessAvg">0</span> hrs
              </div>
              <small class="text-muted">per completed session</small>
            </div>
            <div class="col-auto">
              <i class="fas fa-hourglass-half fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-info shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div
                class="text-xs font-weight-bold text-info text-uppercase mb-1"
              >
                Productivity
              </div>
              <div class="h4 font-weight-bold text-gray-800">
                <span id="sessProductivity">0</span>%
              </div>
              <small class="text-muted">tasks completed</small>
            </div>
            <div class="col-auto">
              <i class="fas fa-chart-line fa-2x text-gray-300"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SEARCH & FILTER -->
  <div class="card shadow mb-4">
    <div class="card-body">
      <div class="row">
        <div class="col-md-4 mb-3">
          <input
            type="text"
            id="searchSession"
            class="form-control"
            placeholder="Search student..."
          />
        </div>
        <div class="col-md-3 mb-3">
          <select id="sessionStatusFilter" class="form-control">
            <option value="">All Status</option>
            <option value="Upcoming">Upcoming</option>
            <option value="Active">Active</option>
            <option value="Completed">Completed</option>
          </select>
        </div>
        <div class="col-md-2 mb-3">
          <button
            id="btnSearchSession"
            type="button"
            class="btn btn-primary btn-block"
          >
            <i class="fas fa-search mr-2"></i>Search
          </button>
        </div>
        <div class="col-md-2 mb-3">
          <button
            id="btnResetSession"
            type="button"
            class="btn btn-secondary btn-block"
          >
            <i class="fas fa-redo mr-2"></i>Reset
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- SESSION TABLE -->
  <div class="card shadow">
    <div class="card-header py-3">
      <h6 class="m-0 font-weight-bold text-primary">Student Sessions</h6>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-bordered table-hover" id="sessionTable">
          <thead class="thead-light">
            <tr>
              <th>#</th>
              <th>Student</th>
              <th>Date</th>
              <th>Start Time</th>
              <th>End Time</th>
              <th>Total Hours</th>
              <th>Status</th>
              <th class="text-center" width="150">Actions</th>
            </tr>
          </thead>
          <tbody id="sessionTableBody">
            <tr>
              <td colspan="8" class="text-center text-muted py-4">
                Loading...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card-footer bg-white">
      <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted" id="sessionCount"
          >Showing <strong>0</strong> session(s)</small
        >
        <nav>
          <ul class="pagination pagination-sm mb-0" id="sessionPagination"></ul>
        </nav>
      </div>
    </div>
  </div>

  <!-- ADD / EDIT SESSION MODAL (moved to <body> by the script) -->
  <div
    class="modal fade"
    id="sessionModal"
    tabindex="-1"
    role="dialog"
    aria-hidden="true"
  >
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="modal-content">
        <form id="sessionForm" autocomplete="off" novalidate>
          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">
              <i class="fas fa-clock mr-2"></i
              ><span id="sessionModalTitle">Add Session</span>
            </h5>
            <button
              type="button"
              class="close text-white"
              data-dismiss="modal"
              data-bs-dismiss="modal"
              aria-label="Close"
            >
              <span aria-hidden="true">&times;</span>
            </button>
          </div>

          <div class="modal-body">
            <input type="hidden" id="sessionId" />

            <div class="form-group">
              <label for="sessionUser"
                >Student <span class="text-danger"></span></label
              >
              <select id="sessionUser" class="form-control"></select>
            </div>

            <div class="form-group">
              <label for="sessionDate"
                >Session Date <span class="text-danger"></span></label
              >
              <input id="sessionDate" type="date" class="form-control" />
            </div>

            <div class="form-row">
              <div class="form-group col-md-6">
                <label for="sessionStart">Start Time</label>
                <input
                  id="sessionStart"
                  type="datetime-local"
                  class="form-control"
                />
              </div>
              <div class="form-group col-md-6">
                <label for="sessionEnd">End Time</label>
                <input
                  id="sessionEnd"
                  type="datetime-local"
                  class="form-control"
                />
                <small class="form-text text-muted"
                  >Leave empty for an active session.</small
                >
              </div>
            </div>

            <div class="form-group mb-0">
              <label for="sessionDuration">Duration (minutes)</label>
              <input
                id="sessionDuration"
                type="number"
                class="form-control"
                min="0"
                max="9999"
                step="0.01"
                placeholder="Auto-filled from start and end"
              />
            </div>
          </div>

          <div class="modal-footer">
            <button
              type="button"
              class="btn btn-secondary"
              data-dismiss="modal"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button type="submit" class="btn btn-primary">
              <i class="fas fa-save mr-1"></i>Save Session
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
