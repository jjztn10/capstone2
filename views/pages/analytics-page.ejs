<div class="container-fluid">

    <!-- ==========================================
         PAGE HEADER
    =========================================== -->

    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>

            <h1 class="h3 mb-1 text-gray-800">
                Analytics
            </h1>

            <p class="text-muted mb-0">
                View your productivity and wellness trends.
            </p>

        </div>

        <button
            id="btnRefreshAnalytics"
            class="btn btn-success">

            <i class="fas fa-sync-alt"></i>

            Refresh

        </button>

    </div>

    <!-- ==========================================
         SUMMARY CARDS
    =========================================== -->

    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow border-left-primary h-100">

                <div class="card-body">

                    <div class="text-xs text-primary text-uppercase font-weight-bold">

                        Productivity Score

                    </div>

                    <div
                        id="productivityScore"
                        class="h3 font-weight-bold">

                        0%

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow border-left-success h-100">

                <div class="card-body">

                    <div class="text-xs text-success text-uppercase font-weight-bold">

                        Study Hours

                    </div>

                    <div
                        id="analyticsStudyHours"
                        class="h3 font-weight-bold">

                        0 hrs

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow border-left-warning h-100">

                <div class="card-body">

                    <div class="text-xs text-warning text-uppercase font-weight-bold">

                        Tasks Completed

                    </div>

                    <div
                        id="analyticsCompletedTasks"
                        class="h3 font-weight-bold">

                        0

                    </div>

                </div>

            </div>

        </div>

        <div class="col-xl-3 col-md-6 mb-4">

            <div class="card shadow border-left-danger h-100">

                <div class="card-body">

                    <div class="text-xs text-danger text-uppercase font-weight-bold">

                        Average Stress

                    </div>

                    <div
                        id="analyticsStress"
                        class="h3 font-weight-bold">

                        0 / 10

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ==========================================
         CHARTS
    =========================================== -->

    <div class="row">

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header">

                    <strong>

                        Weekly Study Hours

                    </strong>

                </div>

                <div class="card-body">

                    <div style="position: relative; height: 300px;">
    <canvas id="studyHoursChart"></canvas>
</div>

                </div>

            </div>

        </div>

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header">

                    <strong>

                        Task Completion

                    </strong>

                </div>

                <div class="card-body">

                    <div style="position: relative; height: 300px;">
    <canvas id="taskChart"></canvas>
</div>

                </div>

            </div>

        </div>

    </div>

    <div class="row">

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header">

                    <strong>

                        Mood Trend

                    </strong>

                </div>

                <div class="card-body">

                    <div style="position: relative; height: 300px;">
    <canvas id="moodChart"></canvas>
</div>

                </div>

            </div>

        </div>

        <div class="col-lg-6 mb-4">

            <div class="card shadow">

                <div class="card-header">

                    <strong>

                        Workload Trend

                    </strong>

                </div>

                <div class="card-body">

                    <<div style="position: relative; height: 300px;">
    <canvas id="workloadChart"></canvas>
</div>

                </div>

            </div>

        </div>

    </div>

</div>