<%- include("../components/page-theme") %>

<div class="pg-page">

    <!-- HERO -->
    <div class="pg-hero">
        <div class="pg-hero-left">
            <div class="pg-hero-icon"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="pg-eyebrow"><i class="fas fa-bolt"></i> Insights</div>
                <h1 class="pg-title">Your <span>Analytics</span></h1>
                <p class="pg-sub">View your productivity and wellness trends.</p>
            </div>
        </div>
        <div class="pg-hero-right">
            <span class="pg-date"><i class="far fa-calendar-alt"></i> <span data-today></span></span>
            <button id="btnRefreshAnalytics" class="btn pg-btn">
                <i class="fas fa-sync-alt"></i> Refresh
            </button>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="pg-stat blue">
                <div>
                    <div class="pg-label">Productivity Score</div>
                    <span class="pg-value" id="productivityScore">0%</span>
                </div>
                <i class="fas fa-rocket pg-ico"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="pg-stat green">
                <div>
                    <div class="pg-label">Study Hours</div>
                    <span class="pg-value" id="analyticsStudyHours">0 hrs</span>
                </div>
                <i class="fas fa-book-open pg-ico"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="pg-stat amber">
                <div>
                    <div class="pg-label">Tasks Completed</div>
                    <span class="pg-value" id="analyticsCompletedTasks">0</span>
                </div>
                <i class="fas fa-check-circle pg-ico"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="pg-stat red">
                <div>
                    <div class="pg-label">Average Stress</div>
                    <span class="pg-value" id="analyticsStress">0 / 10</span>
                </div>
                <i class="fas fa-fire pg-ico"></i>
            </div>
        </div>
    </div>

    <!-- CHARTS -->
    <div class="row">
        <div class="col-lg-6">
            <div class="pg-card">
                <div class="pg-card-head"><h5>Weekly Study Hours</h5></div>
                <div class="pg-card-body">
                    <div class="pg-chart"><canvas id="studyHoursChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pg-card">
                <div class="pg-card-head"><h5>Task Completion</h5></div>
                <div class="pg-card-body">
                    <div class="pg-chart"><canvas id="taskChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="pg-card">
                <div class="pg-card-head"><h5>Mood Trend</h5></div>
                <div class="pg-card-body">
                    <div class="pg-chart"><canvas id="moodChart"></canvas></div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="pg-card">
                <div class="pg-card-head"><h5>Workload Trend</h5></div>
                <div class="pg-card-body">
                    <div class="pg-chart"><canvas id="workloadChart"></canvas></div>
                </div>
            </div>
        </div>
    </div>

</div>