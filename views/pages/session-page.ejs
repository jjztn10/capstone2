<%- include("../components/page-theme") %>

<div class="admin-section pg-page"
     data-session-app
     data-session-api="/userdashboard/api/session"
     data-session-mode="user">

    <!-- HERO -->
    <div class="pg-hero">
        <div class="pg-hero-left">
            <div class="pg-hero-icon"><i class="fas fa-stopwatch"></i></div>
            <div>
                <div class="pg-eyebrow"><i class="fas fa-bolt"></i> Study Tracker</div>
                <h1 class="pg-title">Study <span>Sessions</span></h1>
                <p class="pg-sub">Track your daily study sessions.</p>
            </div>
        </div>
        <div class="pg-hero-right">
            <span class="pg-date"><i class="far fa-calendar-alt"></i> <span data-today></span></span>
            <button class="btn pg-btn pg-btn-add" id="btnStartSession">
                <i class="fas fa-play"></i> Start Session
            </button>
        </div>
    </div>

    <!-- SUMMARY -->
    <div class="row mb-4">
        <div class="col-6 col-xl-3 mb-3">
            <div class="pg-stat green">
                <div>
                    <div class="pg-label">Today's Study</div>
                    <span class="pg-value" id="todayStudy">0 mins</span>
                </div>
                <i class="fas fa-book-open pg-ico"></i>
            </div>
        </div>
        <div class="col-6 col-xl-3 mb-3">
            <div class="pg-stat blue">
                <div>
                    <div class="pg-label">This Week</div>
                    <span class="pg-value" id="weekStudy">0 hrs</span>
                </div>
                <i class="fas fa-calendar-week pg-ico"></i>
            </div>
        </div>
        <div class="col-6 col-xl-3 mb-3">
            <div class="pg-stat amber">
                <div>
                    <div class="pg-label">Total Sessions</div>
                    <span class="pg-value" id="totalSessions">0</span>
                </div>
                <i class="fas fa-layer-group pg-ico"></i>
            </div>
        </div>
        <div class="col-6 col-xl-3 mb-3">
            <div class="pg-stat red">
                <div>
                    <div class="pg-label">Average Duration</div>
                    <span class="pg-value" id="averageDuration">0 mins</span>
                </div>
                <i class="fas fa-hourglass-half pg-ico"></i>
            </div>
        </div>
    </div>

    <!-- TIMER -->
    <div class="pg-card">
        <div class="pg-card-body text-center py-4">

            <div class="pg-eyebrow mb-3">Current Session</div>

            <!-- TASK PICKER -->
            <div class="mx-auto mb-3" style="max-width: 420px;">
                <label for="sessionTask" class="mb-1">What are you working on?</label>
                <select id="sessionTask" class="form-control">
                    <option value="">-- Choose a task --</option>
                </select>
                <p id="currentTaskName" class="mt-2 mb-0 text-success font-weight-bold d-none"></p>
            </div>

            <h1 id="sessionTimer" class="pg-timer">00:00:00</h1>

            <button id="btnStopSession" class="btn pg-btn pg-btn-danger mt-4">
                <i class="fas fa-stop"></i> Stop Session
            </button>

        </div>
    </div>

    <!-- HISTORY -->
    <div class="pg-card">
        <div class="pg-card-head">
            <h6>Session History</h6>
            <button id="btnRefreshSessions" class="btn pg-btn pg-btn-sm" title="Refresh">
                <i class="fas fa-sync-alt"></i>
            </button>
        </div>

        <div class="pg-card-body flush">
            <div class="table-responsive">
                <table class="table pg-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Task</th>
                            <th>Start</th>
                            <th>End</th>
                            <th>Duration</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody id="sessionTableBody">
                        <tr>
                            <td colspan="6" class="text-center text-muted py-5">Loading...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>