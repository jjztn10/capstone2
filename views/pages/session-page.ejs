<div class="admin-section">

    <!-- ==========================================
         PAGE HEADER
    =========================================== -->

    <div class="d-sm-flex align-items-center justify-content-between mb-4">

        <div>

            <h1 class="h3 mb-1 text-gray-800">
                Study Sessions
            </h1>

            <p class="text-muted mb-0">
                Track your daily study sessions.
            </p>

        </div>

        <button
            class="btn btn-success"
            id="btnStartSession">

            <i class="fas fa-play mr-1"></i>

            Start Session

        </button>

    </div>

    <!-- ==========================================
         SUMMARY
    =========================================== -->

    <div class="row mb-4">

        <div class="col-md-3">

            <div class="card shadow border-left-success">

                <div class="card-body">

                    <div class="text-xs text-success text-uppercase font-weight-bold">

                        Today's Study

                    </div>

                    <div
                        class="h4 font-weight-bold"
                        id="todayStudy">

                        0 mins

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-left-primary">

                <div class="card-body">

                    <div class="text-xs text-primary text-uppercase font-weight-bold">

                        This Week

                    </div>

                    <div
                        class="h4 font-weight-bold"
                        id="weekStudy">

                        0 hrs

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-left-warning">

                <div class="card-body">

                    <div class="text-xs text-warning text-uppercase font-weight-bold">

                        Total Sessions

                    </div>

                    <div
                        class="h4 font-weight-bold"
                        id="totalSessions">

                        0

                    </div>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card shadow border-left-danger">

                <div class="card-body">

                    <div class="text-xs text-danger text-uppercase font-weight-bold">

                        Average Duration

                    </div>

                    <div
                        class="h4 font-weight-bold"
                        id="averageDuration">

                        0 mins

                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- ==========================================
         TIMER
    =========================================== -->

    <div class="card shadow mb-4">

        <div class="card-body text-center">

            <h6 class="text-success">

                Current Session

            </h6>

            <h1
                id="sessionTimer"
                class="display-4 font-weight-bold">

                00:00:00

            </h1>

            <button
                id="btnStopSession"
                class="btn btn-danger mt-3">

                <i class="fas fa-stop"></i>

                Stop Session

            </button>

        </div>

    </div>

    <!-- ==========================================
         HISTORY
    =========================================== -->

    <div class="card shadow">

        <div class="card-header py-3 d-flex justify-content-between align-items-center">

            <h6 class="m-0 font-weight-bold text-success">

                Session History

            </h6>

            <button
                id="btnRefreshSessions"
                class="btn btn-success btn-sm">

                <i class="fas fa-sync"></i>

            </button>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead>

                        <tr>

                            <th>Date</th>

                            <th>Start</th>

                            <th>End</th>

                            <th>Duration</th>

                            <th>Status</th>

                        </tr>

                    </thead>

                    <tbody id="sessionTableBody">

                        <tr>

                            <td colspan="5" class="text-center py-5">

                                Loading...

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>