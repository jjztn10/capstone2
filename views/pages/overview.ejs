
<!-- ==========================================
     SMARTWORK ADMIN DASHBOARD OVERVIEW
========================================== -->

<%
    const dashboardUser =
        typeof user !== "undefined" && user
            ? user
            : { name: "Administrator" };

    const dashboardStats =
        typeof stats !== "undefined" && stats
            ? stats
            : {};
%>

<div class="admin-section">

    <!-- PAGE HEADER -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800">
                Dashboard Overview
            </h1>

            <p class="text-muted mb-0">
                Welcome back,
                <strong><%= dashboardUser.name || "Administrator" %></strong>
            </p>
        </div>

        <button
            id="btnRefreshDashboard"
            type="button"
            class="btn btn-primary shadow-sm">

            <i class="fas fa-sync-alt mr-2"></i>
            Refresh Dashboard
        </button>
    </div>

    <!-- ==========================================
         STATISTICS
    =========================================== -->

    <div class="row">

        <!-- TOTAL USERS -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Users
                            </div>

                            <div class="h4 mb-0 font-weight-bold text-gray-800">
                                <%= dashboardStats.totalUsers || 0 %>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- TOTAL TASKS -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Total Tasks
                            </div>

                            <div class="h4 mb-0 font-weight-bold text-gray-800">
                                <%= dashboardStats.totalTasks || 0 %>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-tasks fa-2x text-gray-300"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- MOOD ENTRIES -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Mood Entries
                            </div>

                            <div class="h4 mb-0 font-weight-bold text-gray-800">
                                <%= dashboardStats.totalMoods || 0 %>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-smile fa-2x text-gray-300"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

        <!-- WORK SESSIONS -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Work Sessions
                            </div>

                            <div class="h4 mb-0 font-weight-bold text-gray-800">
                                <%= dashboardStats.totalSessions || 0 %>
                            </div>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- ==========================================
         QUICK ACTIONS
    =========================================== -->

    <div class="card shadow mb-4">

        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">
                Quick Actions
            </h6>
        </div>

        <div class="card-body">
            <div class="row">

                <div class="col-md-3 mb-3">
                    <button
                        id="quickAddUser"
                        type="button"
                        class="btn btn-primary btn-block">

                        <i class="fas fa-user-plus mr-2"></i>
                        Add User
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button
                        id="quickAddTask"
                        type="button"
                        class="btn btn-success btn-block">

                        <i class="fas fa-plus-circle mr-2"></i>
                        New Task
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button
                        id="quickMood"
                        type="button"
                        class="btn btn-info btn-block">

                        <i class="fas fa-smile mr-2"></i>
                        Mood Analytics
                    </button>
                </div>

                <div class="col-md-3 mb-3">
                    <button
                        id="quickLeaderboard"
                        type="button"
                        class="btn btn-warning btn-block">

                        <i class="fas fa-trophy mr-2"></i>
                        Leaderboard
                    </button>
                </div>

            </div>
        </div>

    </div>

    <div class="row">

    <!-- Productivity Overview -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card shadow">

            <div class="card-header">
                <h6>Productivity Overview</h6>
            </div>

            <div class="card-body">
                <div class="chart-container">
                    <canvas id="productivityChart"></canvas>
                </div>
            </div>

        </div>
    </div>

    <!-- Task Completion -->
    <div class="col-lg-6 mb-4">
        <div class="card chart-card shadow">

            <div class="card-header">
                <h6>Task Completion</h6>
            </div>

            <div class="card-body">
                <div class="chart-container">
                    <canvas id="taskCompletionChart"></canvas>
                </div>
            </div>

        </div>
    </div>

</div>