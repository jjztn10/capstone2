<section id="tasks" class="admin-section">

  <!-- PAGE HEADER -->
  <div class="sw-page-header">
    <div class="sw-header-left">
      <div class="sw-header-icon"><i class="fas fa-tasks"></i></div>
      <div>
        <h2>Task Management</h2>
        <p>Monitor, edit, and manage student workloads, deadlines, and progress.</p>
      </div>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-primary shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Tasks</div>
              <div class="h3 mb-0 font-weight-bold text-gray-800" id="totalTasks">0</div>
            </div>
            <div class="col-auto"><i class="fas fa-tasks fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-warning shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">Pending</div>
              <div class="h3 mb-0 font-weight-bold text-gray-800" id="pendingTasks">0</div>
            </div>
            <div class="col-auto"><i class="fas fa-hourglass-half fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-info shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-info text-uppercase mb-1">In Progress</div>
              <div class="h3 mb-0 font-weight-bold text-gray-800" id="progressTasks">0</div>
            </div>
            <div class="col-auto"><i class="fas fa-spinner fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
      <div class="card border-left-success shadow h-100 py-2">
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col mr-2">
              <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Completed</div>
              <div class="h3 mb-0 font-weight-bold text-gray-800" id="completedTasks">0</div>
            </div>
            <div class="col-auto"><i class="fas fa-check-circle fa-2x text-gray-300"></i></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- SEARCH & FILTER -->
  <div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-wrap align-items-center justify-content-between">
      <h6 class="m-0 font-weight-bold text-primary">
        <i class="fas fa-search mr-2"></i>Search &amp; Filters
      </h6>
      <small class="text-muted">Find tasks quickly using keywords or filters.</small>
    </div>

    <div class="card-body">
      <div class="row align-items-end">
        <div class="col-lg-4 mb-3">
          <label class="small font-weight-bold">Search Task</label>
          <div class="input-group">
            <div class="input-group-prepend">
              <span class="input-group-text"><i class="fas fa-search"></i></span>
            </div>
            <input id="searchTask" type="text" class="form-control" placeholder="Search by task title or subject..." />
          </div>
        </div>

        <div class="col-lg-2 mb-3">
          <label class="small font-weight-bold">Status</label>
          <select id="statusFilter" class="form-control">
            <option value="">All Status</option>
          </select>
        </div>

        <div class="col-lg-2 mb-3">
          <label class="small font-weight-bold">Priority</label>
          <select id="priorityFilter" class="form-control">
            <option value="">All Priority</option>
            <option value="High">🔴 High</option>
            <option value="Medium">🟡 Medium</option>
            <option value="Low">🟢 Low</option>
          </select>
        </div>

        <div class="col-lg-2 mb-3">
          <button id="btnSearchTask" type="button" class="btn btn-primary btn-block">
            <i class="fas fa-search mr-2"></i>Search
          </button>
        </div>

        <div class="col-lg-2 mb-3">
          <button id="btnResetTask" type="button" class="btn btn-secondary btn-block">
            <i class="fas fa-sync-alt mr-2"></i>Reset
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- TASK TABLE -->
  <div class="card shadow mb-4">
    <div class="card-header py-3 d-flex flex-wrap align-items-center justify-content-between">
      <div>
        <h6 class="m-0 font-weight-bold text-primary">
          <i class="fas fa-list-ul mr-2"></i>Task List
        </h6>
        <small class="text-muted">View, edit and monitor all SmartWork tasks.</small>
      </div>
      <span class="badge badge-primary px-3 py-2 mt-2 mt-md-0">
        <i class="fas fa-tasks mr-1"></i><span id="taskHeaderCount">0</span> Tasks
      </span>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table id="taskTable" class="table table-hover table-bordered mb-0">
          <thead class="thead-light">
            <tr>
              <th width="60" class="text-center">#</th>
              <th>Task</th>
              <th width="220">Assigned To</th>
              <th width="130" class="text-center">Priority</th>
              <th width="140" class="text-center">Status</th>
              <th width="170">Due Date</th>
              <th width="170" class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody id="tasksTableBody">
            <tr>
              <td colspan="7" class="text-center py-5 text-muted">
                <div class="mb-3"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i></div>
                <strong>Loading tasks...</strong>
                <div class="small mt-2">Please wait while SmartWork retrieves your data.</div>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="card-footer bg-white">
      <div class="row align-items-center">
        <div class="col-md-6">
          <small id="taskCount" class="text-muted">Showing <strong>0</strong> task(s)</small>
        </div>
        <div class="col-md-6">
          <nav class="float-md-right mt-3 mt-md-0">
            <ul id="taskPagination" class="pagination pagination-sm mb-0 justify-content-md-end"></ul>
          </nav>
        </div>
      </div>
    </div>
  </div>

  <!-- EDIT TASK MODAL (opened from the Edit button in the table) -->
  <div class="modal fade" id="taskModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable task-modal" role="document">
      <div class="modal-content">
        <form id="taskForm" autocomplete="off" novalidate>

          <div class="modal-header bg-primary text-white">
            <h5 class="modal-title">
              <i class="fas fa-edit mr-2"></i><span id="taskModalTitle">Edit Task</span>
            </h5>
            <button type="button" class="close text-white" data-dismiss="modal" data-bs-dismiss="modal" aria-label="Close">
              <span aria-hidden="true">&times;</span>
            </button>
          </div>

          <div class="modal-body">
            <input type="hidden" id="taskId" />

            <!-- TASK INFORMATION -->
            <div class="card border-left-primary shadow-sm mb-4">
              <div class="card-header">
                <h6 class="font-weight-bold text-primary mb-0">
                  <i class="fas fa-info-circle mr-2"></i>Task Information
                </h6>
              </div>
              <div class="card-body">
                <div class="form-group">
                  <label for="taskTitle">Task Title</label>
                  <input id="taskTitle" type="text" class="form-control" maxlength="255" placeholder="Enter task title..." required />
                </div>
                <div class="form-group mb-0">
                  <label for="taskDescription">Description</label>
                  <textarea id="taskDescription" rows="4" class="form-control" placeholder="Describe this task..."></textarea>
                </div>
              </div>
            </div>

            <!-- ASSIGNMENT -->
            <div class="card border-left-info shadow-sm mb-4">
              <div class="card-header">
                <h6 class="font-weight-bold text-info mb-0">
                  <i class="fas fa-user-check mr-2"></i>Assignment Details
                </h6>
              </div>
              <div class="card-body">
                <div class="form-row">
                  <div class="form-group col-md-6">
                    <label for="taskUser">Assigned To</label>
                    <select id="taskUser" class="form-control" required></select>
                  </div>
                  <div class="form-group col-md-6">
                    <label for="taskSubject">Subject / Category</label>
                    <input id="taskSubject" type="text" class="form-control" maxlength="120" placeholder="Example: Capstone, Thesis, Programming" />
                  </div>
                </div>
              </div>
            </div>

            <!-- TASK SETTINGS -->
            <div class="card border-left-warning shadow-sm mb-4">
              <div class="card-header">
                <h6 class="font-weight-bold text-warning mb-0">
                  <i class="fas fa-sliders-h mr-2"></i>Task Settings
                </h6>
              </div>
              <div class="card-body">
                <div class="form-row">
                  <div class="form-group col-md-4">
                    <label for="taskPriority">Priority</label>
                    <select id="taskPriority" class="form-control">
                      <option value="High">🔴 High</option>
                      <option value="Medium" selected>🟡 Medium</option>
                      <option value="Low">🟢 Low</option>
                    </select>
                  </div>
                  <div class="form-group col-md-4">
                    <label for="taskStatus">Status</label>
                    <select id="taskStatus" class="form-control"></select>
                  </div>
                  <div class="form-group col-md-4">
                    <label for="taskDeadline">Due Date</label>
                    <input id="taskDeadline" type="datetime-local" class="form-control" />
                  </div>
                </div>
              </div>
            </div>

            <!-- WORKLOAD -->
            <div class="card border-left-success shadow-sm">
              <div class="card-header">
                <h6 class="font-weight-bold text-success mb-0">
                  <i class="fas fa-chart-line mr-2"></i>Workload Information
                </h6>
              </div>
              <div class="card-body">
                <div class="form-row">
                  <div class="form-group col-md-6 mb-0">
                    <label for="taskHours">Estimated Hours</label>
                    <input id="taskHours" type="number" class="form-control" min="0" max="999" step="0.25" value="1" />
                  </div>
                  <div class="form-group col-md-6 mb-0">
                    <label for="taskWeight">Task Weight</label>
                    <input id="taskWeight" type="number" class="form-control" min="0" max="999" step="0.10" value="1" />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="modal-footer bg-light">
            <button type="button" class="btn btn-secondary px-4" data-dismiss="modal" data-bs-dismiss="modal">
              <i class="fas fa-times mr-2"></i>Cancel
            </button>
            <button type="submit" class="btn btn-primary px-4">
              <i class="fas fa-save mr-2"></i>Save Changes
            </button>
          </div>

        </form>
      </div>
    </div>
  </div>

</section>