<div id="adminLeaderboard" class="sw-leaderboard admin-section">

  <!-- PAGE HEADER -->
  <div class="sw-page-header">
    <div class="sw-header-left">
      <div class="sw-header-icon"><i class="fas fa-trophy"></i></div>
      <div>
        <h2>Leaderboard</h2>
        <p>Track user productivity, achievements, and rankings.</p>
      </div>
    </div>

    <div class="sw-header-actions">
      <button id="leaderboardRefresh" type="button" class="btn btn-primary shadow">
        <i class="fas fa-sync-alt mr-2"></i>Refresh
      </button>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="leaderboard-stats">
    <div class="leaderboard-stat-card">
      <div class="stat-icon users-icon"><i class="fas fa-users"></i></div>
      <div>
        <span class="stat-label">TOTAL PARTICIPANTS</span>
        <h3 id="lbTotalUsers">0</h3>
      </div>
    </div>

    <div class="leaderboard-stat-card">
      <div class="stat-icon score-icon"><i class="fas fa-star"></i></div>
      <div>
        <span class="stat-label">AVERAGE SCORE</span>
        <h3 id="lbAverageScore">0</h3>
      </div>
    </div>

    <div class="leaderboard-stat-card">
      <div class="stat-icon winner-icon"><i class="fas fa-crown"></i></div>
      <div>
        <span class="stat-label">TOP PERFORMER</span>
        <h3 id="lbTopPerformer">---</h3>
      </div>
    </div>

    <div class="leaderboard-stat-card">
      <div class="stat-icon points-icon"><i class="fas fa-chart-line"></i></div>
      <div>
        <span class="stat-label">HIGHEST SCORE</span>
        <h3 id="lbHighestScore">0</h3>
      </div>
    </div>
  </div>

  <!-- TOP 3 PODIUM -->
  <div class="leaderboard-podium-section">
    <div class="podium-title">
      <h3><i class="fas fa-award"></i> Top Performers</h3>
      <p>Celebrating the most productive users</p>
    </div>

    <div id="leaderboardPodium" class="leaderboard-podium">
      <!-- SECOND PLACE -->
      <div class="podium-card podium-second">
        <div class="podium-avatar"><i class="fas fa-user"></i></div>
        <span class="podium-rank">2ND PLACE</span>
        <h4 id="lbSecondName">---</h4>
        <span class="podium-score" id="lbSecondScore">0 points</span>
        <div class="podium-block podium-block-second">
          <i class="fas fa-medal"></i>
          <span>2</span>
        </div>
      </div>

      <!-- FIRST PLACE -->
      <div class="podium-card podium-first">
        <div class="podium-avatar"><i class="fas fa-crown"></i></div>
        <span class="podium-rank">1ST PLACE</span>
        <h4 id="lbFirstName">---</h4>
        <span class="podium-score" id="lbFirstScore">0 points</span>
        <div class="podium-block podium-block-first">
          <i class="fas fa-trophy"></i>
          <span>1</span>
        </div>
      </div>

      <!-- THIRD PLACE -->
      <div class="podium-card podium-third">
        <div class="podium-avatar"><i class="fas fa-user"></i></div>
        <span class="podium-rank">3RD PLACE</span>
        <h4 id="lbThirdName">---</h4>
        <span class="podium-score" id="lbThirdScore">0 points</span>
        <div class="podium-block podium-block-third">
          <i class="fas fa-medal"></i>
          <span>3</span>
        </div>
      </div>
    </div>
  </div>

  <!-- RANKINGS -->
  <div class="leaderboard-table-card">
    <div class="leaderboard-table-header">
      <div>
        <h3><i class="fas fa-list-ol"></i> User Rankings</h3>
        <p>Complete productivity ranking of registered users</p>
      </div>
    </div>

    <!-- SEARCH -->
    <div class="leaderboard-search-row">
      <div class="leaderboard-search-box">
        <i class="fas fa-search"></i>
        <input type="text" id="leaderboardSearch" placeholder="Search by name or email..." />
        <button type="button" id="leaderboardClearSearch" aria-label="Clear search">
          <i class="fas fa-times"></i>
        </button>
      </div>

      <span id="leaderboardResultCount" class="leaderboard-result-count">0 users</span>
    </div>

    <!-- TABLE -->
    <div class="leaderboard-table-wrapper">
      <table class="table leaderboard-table">
        <thead>
          <tr>
            <th>RANK</th>
            <th>USER</th>
            <th>SCORE</th>
            <th>TOTAL POINTS</th>
            <th>WEEKLY POINTS</th>
            <th>COMPLETED TASKS</th>
            <th>STREAK</th>
          </tr>
        </thead>

        <tbody id="leaderboardTableBody">
          <tr>
            <td colspan="7" class="text-center py-4">Loading leaderboard...</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- FOOTER -->
    <div class="leaderboard-footer">
      <span id="leaderboardFooterText">Showing 0 users</span>
    </div>
  </div>
</div>

